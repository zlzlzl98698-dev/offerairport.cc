---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import TableOfContents from '../components/common/TableOfContents.astro';
import AffiliateDisclosure from '../components/commercial/AffiliateDisclosure.astro';
import ComparisonTable from '../components/commercial/ComparisonTable.astro';
import RelatedBrand from '../components/commercial/RelatedBrand.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import FaqAccordion from '../components/common/FaqAccordion.astro';
import { getBrandBySlug, type BrandRecord } from '../data/brands';
import { SITE_CONFIG } from '../data/site';
import { buildBreadcrumbSchema, buildCanonicalUrl, buildFaqSchema, formatDateZh, type BreadcrumbItem, type FAQItem } from '../utils/seo';
import type { AnyContentEntry } from '../utils/content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  urlPath: string;
  category: string;
  pubDate: Date;
  updatedDate?: Date;
  verifiedAt?: Date;
  author?: string;
  tags?: string[];
  brandSlugs?: string[];
  verdict?: string;
  sources?: string[];
  faqs?: FAQItem[];
  headings?: Heading[];
  breadcrumbs: BreadcrumbItem[];
  relatedEntries?: AnyContentEntry[];
}

const {
  title,
  description,
  urlPath,
  category,
  pubDate,
  updatedDate,
  verifiedAt,
  author = SITE_CONFIG.author,
  tags = [],
  brandSlugs = [],
  verdict,
  sources = [],
  faqs = [],
  headings = [],
  breadcrumbs,
  relatedEntries = [],
} = Astro.props;

const comparedBrands: BrandRecord[] = brandSlugs
  .map((s) => getBrandBySlug(s))
  .filter((b): b is BrandRecord => Boolean(b));

const schemas: object[] = [
  buildBreadcrumbSchema(breadcrumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: buildCanonicalUrl(urlPath),
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate || pubDate).toISOString(),
    inLanguage: 'zh-CN',
    author: { '@type': 'Organization', name: author },
    publisher: { '@type': 'Organization', name: SITE_CONFIG.name, url: SITE_CONFIG.domain },
  },
];

if (faqs.length > 0) {
  schemas.push(buildFaqSchema(faqs));
}
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={urlPath}
  ogType="article"
  author={author}
  publishDate={pubDate.toISOString()}
  modifiedDate={(updatedDate || pubDate).toISOString()}
  tags={tags}
  structuredData={schemas}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <article class="lg:col-span-8 min-w-0" data-pagefind-body>
        <header class="mb-7 pb-6 border-b border-border-subtle">
          <div class="flex flex-wrap items-center gap-2 mb-3 text-xs">
            <span class="px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200 font-medium">
              横向对比 · {category}
            </span>
            <span class="px-2.5 py-1 rounded-full bg-bg-surface text-text-title border border-border-subtle font-mono">
              核实日期：{formatDateZh(verifiedAt || updatedDate || pubDate)}
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold text-text-title leading-tight mb-4">
            {title}
          </h1>

          <div class="rounded-2xl bg-bg-surface border border-border-subtle p-5">
            <div class="text-sm font-bold text-text-title mb-1">对比方法与核心结论</div>
            <p class="text-sm sm:text-base text-text-body leading-relaxed">
              {verdict || description}
            </p>
          </div>
        </header>

        <div class="mb-6">
          <AffiliateDisclosure compact />
        </div>

        {comparedBrands.length > 0 && (
          <ComparisonTable
            brands={comparedBrands}
            title={`参与对比品牌参数矩阵（共 ${comparedBrands.length} 家）`}
          />
        )}

        <div class="editorial-prose">
          <slot />
        </div>

        <FaqAccordion title="横向对比 FAQ" faqs={faqs} />

        {sources.length > 0 && (
          <section class="mt-8 rounded-2xl bg-bg-surface border border-border-subtle p-4 text-xs text-text-muted">
            <h3 class="font-semibold text-text-title mb-1.5">对比依据与资料来源</h3>
            <ul class="list-disc pl-5 space-y-1">
              {sources.map((src) => <li>{src}</li>)}
            </ul>
          </section>
        )}

        {comparedBrands.length > 0 && (
          <section class="mt-10 space-y-4">
            <h2 class="text-lg font-bold text-text-title">相关品牌档案入口</h2>
            <div class="grid grid-cols-1 gap-4">
              {comparedBrands.slice(0, 4).map((b) => (
                <RelatedBrand brandSlug={b.slug} showRegister={false} />
              ))}
            </div>
          </section>
        )}
      </article>

      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24" data-pagefind-ignore>
        <TableOfContents headings={headings} />
        <div class="rounded-2xl border border-border-subtle bg-bg-surface p-5 text-xs space-y-2">
          <h3 class="text-sm font-bold text-text-title">比较维度说明</h3>
          <p class="text-text-body leading-relaxed">
            所有对比均在同一套价格口径下展开：年付折算月均价单独标注，不与真实月付混淆；不跨测速工具直接作绝对名次排序。
          </p>
        </div>
      </aside>
    </div>

    {relatedEntries.length > 0 && (
      <section class="mt-14 pt-8 border-t border-border-subtle" data-pagefind-ignore>
        <h2 class="text-xl font-bold text-text-title mb-5">更多对比与评测</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedEntries.slice(0, 3).map((entry) => (
            <ArticleCard
              title={entry.data.title}
              description={entry.data.description}
              urlPath={entry.data.urlPath}
              pageType={entry.data.pageType}
              category={entry.data.category}
              pubDate={entry.data.pubDate}
              updatedDate={entry.data.updatedDate}
              body={entry.body}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
