---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import TableOfContents from '../components/common/TableOfContents.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import FaqAccordion from '../components/common/FaqAccordion.astro';
import { SITE_CONFIG } from '../data/site';
import { buildBreadcrumbSchema, buildCanonicalUrl, buildFaqSchema, formatDateZh, estimateReadingMinutes, type BreadcrumbItem, type FAQItem } from '../utils/seo';
import type { AnyContentEntry } from '../utils/content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  urlPath: string;
  category: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  platform?: string;
  appVersion?: string;
  sources?: string[];
  faqs?: FAQItem[];
  headings?: Heading[];
  breadcrumbs: BreadcrumbItem[];
  relatedEntries?: AnyContentEntry[];
  bodyText?: string;
  showSelectionGuideLink?: boolean;
}

const {
  title,
  description,
  urlPath,
  category,
  pubDate,
  updatedDate,
  author = SITE_CONFIG.author,
  tags = [],
  platform,
  appVersion,
  sources = [],
  faqs = [],
  headings = [],
  breadcrumbs,
  relatedEntries = [],
  bodyText = '',
  showSelectionGuideLink = false,
} = Astro.props;

const canonical = buildCanonicalUrl(urlPath);
const mins = estimateReadingMinutes(bodyText);

const schemas: object[] = [
  buildBreadcrumbSchema(breadcrumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: canonical,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate || pubDate).toISOString(),
    inLanguage: 'zh-CN',
    author: {
      '@type': 'Organization',
      name: author,
    },
    publisher: {
      '@type': 'Organization',
      name: SITE_CONFIG.name,
      url: SITE_CONFIG.domain,
    },
  },
];

if (faqs.length > 0) {
  schemas.push(buildFaqSchema(faqs));
}
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={urlPath}
  ogType="article"
  author={author}
  publishDate={pubDate.toISOString()}
  modifiedDate={(updatedDate || pubDate).toISOString()}
  tags={tags}
  structuredData={schemas}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Main Tutorial Column -->
      <article class="lg:col-span-8 min-w-0" data-pagefind-body>
        <header class="mb-7 pb-6 border-b border-border-subtle">
          <div class="flex flex-wrap items-center gap-2 mb-3 text-xs">
            <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200 font-medium">
              技术教程 · {category}
            </span>
            {platform && (
              <span class="px-2.5 py-1 rounded-full bg-bg-surface text-text-title border border-border-subtle">
                适用平台：{platform}
              </span>
            )}
            {appVersion && (
              <span class="px-2.5 py-1 rounded-full bg-bg-surface text-text-title border border-border-subtle font-mono">
                版本参考：{appVersion}
              </span>
            )}
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold text-text-title leading-tight mb-4">
            {title}
          </h1>

          <div class="rounded-2xl bg-bg-surface border border-border-subtle p-4 sm:p-5 text-sm sm:text-base text-text-body leading-relaxed">
            <strong class="text-text-title font-semibold">核心摘要：</strong>
            {description}
          </div>

          <div class="flex flex-wrap items-center gap-4 mt-4 text-xs text-text-muted font-mono">
            <span>作者：{author}</span>
            <span>发布：{formatDateZh(pubDate)}</span>
            {updatedDate && <span>更新：{formatDateZh(updatedDate)}</span>}
            <span>预计阅读：{mins} 分钟</span>
          </div>
        </header>

        <!-- Mobile TOC -->
        {headings.length > 0 && (
          <div class="lg:hidden mb-6">
            <TableOfContents headings={headings} />
          </div>
        )}

        <div class="editorial-prose">
          <slot />
        </div>

        <FaqAccordion title="常见问题 FAQ" faqs={faqs} headingId="tutorial-faq-heading" />

        {sources.length > 0 && (
          <section class="mt-8 rounded-2xl bg-bg-surface border border-border-subtle p-4 text-xs text-text-muted">
            <h3 class="font-semibold text-text-title mb-1.5">参考资料与官方来源</h3>
            <ul class="list-disc pl-5 space-y-1">
              {sources.map((src) => (
                <li>{src}</li>
              ))}
            </ul>
          </section>
        )}

        {showSelectionGuideLink && (
          <aside class="mt-8 rounded-2xl border border-border-subtle bg-white p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4" data-pagefind-ignore>
            <div>
              <h3 class="text-sm font-bold text-text-title">尚未配置订阅服务？</h3>
              <p class="text-xs text-text-muted mt-1">
                若你需要了解不同线路与客户端兼容差异，可先阅读本站独立选型方法论，再自行决策。
              </p>
            </div>
            <a
              href="/reviews/2026-airport-selection-methodology/"
              class="shrink-0 px-4 py-2 rounded-xl border border-border-subtle text-xs font-semibold text-text-title hover:border-brand-primary hover:text-brand-primary transition-colors"
            >
              查看服务选择指南 →
            </a>
          </aside>
        )}
      </article>

      <!-- Sidebar TOC & Related Tutorials (No commercial CTA injected) -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24" data-pagefind-ignore>
        <TableOfContents headings={headings} />

        <div class="rounded-2xl border border-border-subtle bg-white p-5">
          <h3 class="text-sm font-bold text-text-title mb-3">同系列延伸教程</h3>
          <ul class="space-y-2.5 text-sm">
            <li>
              <a href="/clash/verge-official-download-guide/" class="text-text-body hover:text-brand-primary block">
                → Clash Verge Rev 官方下载与核验
              </a>
            </li>
            <li>
              <a href="/clash/verge-subscription-import-guide/" class="text-text-body hover:text-brand-primary block">
                → 订阅导入与自动更新配置
              </a>
            </li>
            <li>
              <a href="/clash/tun-mode-udp-guide/" class="text-text-body hover:text-brand-primary block">
                → TUN 虚拟网卡模式与终端代理
              </a>
            </li>
            <li>
              <a href="/clash/fix-node-timeout-errors/" class="text-text-body hover:text-brand-primary block">
                → 节点全部 Timeout 超时排查
              </a>
            </li>
          </ul>
        </div>
      </aside>
    </div>

    {relatedEntries.length > 0 && (
      <section class="mt-14 pt-8 border-t border-border-subtle" data-pagefind-ignore>
        <h2 class="text-xl font-bold text-text-title mb-5">相关实用教程推荐</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedEntries.slice(0, 3).map((entry) => (
            <ArticleCard
              title={entry.data.title}
              description={entry.data.description}
              urlPath={entry.data.urlPath}
              pageType={entry.data.pageType}
              category={entry.data.category}
              pubDate={entry.data.pubDate}
              updatedDate={entry.data.updatedDate}
              body={entry.body}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
