---
import { render } from 'astro:content';
import ComparisonLayout from '../../layouts/ComparisonLayout.astro';
import { getAllPublishedContent, getPublishedComparisons, getRelatedEntries } from '../../utils/content';

export async function getStaticPaths() {
  const [comparisons, all] = await Promise.all([
    getPublishedComparisons(),
    getAllPublishedContent(),
  ]);
  return comparisons.map((entry) => {
    const slug = entry.data.urlPath.replace(/^\/comparisons\//, '').replace(/\/$/, '');
    return {
      params: { slug },
      props: { entry, all },
    };
  });
}

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const related = getRelatedEntries(entry.data.urlPath, all, entry.data.relatedSlugs, entry.data.category, 3);
---

<ComparisonLayout
  title={entry.data.title}
  description={entry.data.description}
  urlPath={entry.data.urlPath}
  category={entry.data.category}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  verifiedAt={entry.data.verifiedAt}
  author={entry.data.author}
  tags={entry.data.tags}
  brandSlugs={entry.data.brandSlugs}
  verdict={entry.data.verdict}
  sources={entry.data.sources}
  faqs={entry.data.faqs}
  headings={headings}
  relatedEntries={related}
  breadcrumbs={[
    { name: '首页', href: '/' },
    { name: '横向对比', href: '/comparisons/' },
    { name: entry.data.title, href: entry.data.urlPath },
  ]}
>
  <Content />
</ComparisonLayout>
