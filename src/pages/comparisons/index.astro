---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import AffiliateDisclosure from '../../components/commercial/AffiliateDisclosure.astro';
import FaqAccordion from '../../components/common/FaqAccordion.astro';
import { getPublishedComparisons } from '../../utils/content';
import { buildBreadcrumbSchema, buildCanonicalUrl, buildFaqSchema, type FAQItem } from '../../utils/seo';

const comparisons = await getPublishedComparisons();

const breadcrumbs = [
  { name: '首页', href: '/' },
  { name: '横向对比', href: '/comparisons/' },
];

const comparisonFaqs: FAQItem[] = [
  {
    question: '为什么横向对比页绝不把 2026-08-11 测速快照排出“第 1 名到第 16 名总榜”？',
    answer:
      '同批次测速抓取时间跨越凌晨闲时至晚间高峰，且部分样本采用不同工具与协议版本（如 MAI-TEST-BOT SS vs 喵速 VLESS），仅能在各自声明的测试维度内独立对比，直接排总榜会误导读者。',
  },
  {
    question: '在对比月付价格时，如何识别“¥5.6/月”或“¥8.25/月”的真实支付条件？',
    answer:
      '本栏目所有费用横比均严格拆分「真实单月实付价格」与「年付折算月均价」，标为年付折算的低价档几乎全部要求结账时一次付清整年款且不支持退款。',
  },
  {
    question: '技术方案对比（Mihomo vs sing-box、OpenClash vs Nikki）针对哪些环境？',
    answer:
      '聚焦 2026 年仍在维护的活跃开源版本，明确标明如 Nikki 对 OpenWrt 24.10+ 的系统版本前提以及部分旧核向新版无痛迁移的边界。',
  },
];

const title = '机场、VPN 与代理协议横向对比专栏';
const description =
  '围绕同一评估维度展开的多品牌、多协议及客户端软件横向对比，明确拆分年付折算与真实月付成本，拒绝不注明测试环境的排行榜。';

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: buildCanonicalUrl('/comparisons/'),
  },
  buildFaqSchema(comparisonFaqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl="/comparisons/" structuredData={schemas}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10" data-pagefind-body>
    <Breadcrumbs items={breadcrumbs} />

    <header class="rounded-3xl bg-bg-surface border border-border-subtle p-6 sm:p-8 mb-6">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200 mb-3">
        独立评测与对比区
      </span>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-text-title mb-3">
        横向对比与决策基准
      </h1>
      <p class="text-sm sm:text-base text-text-body max-w-3xl leading-relaxed">
        在同一套数据标准下对比不同价位机场、IEPL 专线与 BGP 中转、传统 VPN 与 Clash 规则代理，以及主流第三方客户端软件。
      </p>
    </header>

    <div class="mb-6">
      <AffiliateDisclosure compact />
    </div>

    <section class="mb-8 rounded-2xl border border-border-subtle bg-white overflow-hidden">
      <div class="px-5 py-3.5 bg-bg-surface border-b border-border-subtle text-sm font-bold text-text-title">
        四类主流决策横比快速指引（先选场景再进长文）
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[560px] lg:min-w-0 text-left border-collapse text-xs sm:text-[13px]">
          <thead>
            <tr class="bg-bg-surface/60 border-b border-border-subtle text-text-title">
              <th class="p-3 font-bold">你的核心比较问题</th>
              <th class="p-3 font-bold">关注核心字段</th>
              <th class="p-3 font-bold">直达核心横向对比</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-subtle text-text-body">
            <tr>
              <td class="p-3 font-semibold text-text-title">18–25 元预算怎么挑，年付 5.6 元能不能买？</td>
              <td class="p-3">月付实价 vs 年付折算、流量与审计风险</td>
              <td class="p-3"><a href="/comparisons/budget-18-25-yuan-airports/" class="text-brand-primary font-semibold hover:underline">18–25 元月付对比 →</a> / <a href="/comparisons/cheap-annual-airports-audit/" class="text-brand-primary font-semibold hover:underline">低价年付审计 →</a></td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-text-title">桌面、软路由与底层内核软件哪家强？</td>
              <td class="p-3">Mihomo vs sing-box、OpenClash vs Nikki</td>
              <td class="p-3"><a href="/comparisons/desktop-proxy-clients-benchmark/" class="text-brand-primary font-semibold hover:underline">桌面客户端横评 →</a> / <a href="/comparisons/openclash-vs-passwall2-vs-nikki/" class="text-brand-primary font-semibold hover:underline">软路由插件对比 →</a></td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-text-title">专线与 BGP、VLESS 与 Hy2 差异？</td>
              <td class="p-3">晚高峰丢包、UDP 限速及 AI 稳定解锁</td>
              <td class="p-3"><a href="/comparisons/iepl-vs-bgp-transit/" class="text-brand-primary font-semibold hover:underline">专线 vs 中转 →</a> / <a href="/comparisons/vless-trojan-hysteria2-comparison/" class="text-brand-primary font-semibold hover:underline">三大协议横评 →</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {comparisons.map((entry) => (
        <ArticleCard
          title={entry.data.title}
          description={entry.data.description}
          urlPath={entry.data.urlPath}
          pageType={entry.data.pageType}
          category={entry.data.category}
          pubDate={entry.data.pubDate}
          updatedDate={entry.data.updatedDate}
          body={entry.body}
        />
      ))}
    </div>

    <FaqAccordion title="横向对比栏目常见疑问 FAQ" faqs={comparisonFaqs} />
  </div>
</BaseLayout>
