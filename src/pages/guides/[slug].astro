---
import { render } from 'astro:content';
import TutorialLayout from '../../layouts/TutorialLayout.astro';
import { getAllPublishedContent, getRelatedEntries } from '../../utils/content';

export async function getStaticPaths() {
  const all = await getAllPublishedContent();
  return all
    .filter((e) => e.data.urlPath.startsWith('/guides/') && e.data.urlPath !== '/guides/')
    .map((entry) => {
      const slug = entry.data.urlPath.replace(/^\/guides\//, '').replace(/\/$/, '');
      return {
        params: { slug },
        props: { entry, all },
      };
    });
}

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const related = getRelatedEntries(entry.data.urlPath, all, entry.data.relatedSlugs, entry.data.category, 3);
---

<TutorialLayout
  title={entry.data.title}
  description={entry.data.description}
  urlPath={entry.data.urlPath}
  category={entry.data.category}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  tags={entry.data.tags}
  platform={entry.data.platform}
  appVersion={entry.data.appVersion}
  sources={entry.data.sources}
  faqs={entry.data.faqs}
  headings={headings}
  bodyText={entry.body}
  relatedEntries={related}
  showSelectionGuideLink={true}
  breadcrumbs={[
    { name: '首页', href: '/' },
    { name: '实用教程', href: '/clash/' },
    { name: entry.data.title, href: entry.data.urlPath },
  ]}
>
  <Content />
</TutorialLayout>
