---
import { render } from 'astro:content';
import TopicLayout from '../../layouts/TopicLayout.astro';
import TutorialLayout from '../../layouts/TutorialLayout.astro';
import SubtopicGuideSection from '../../components/common/SubtopicGuideSection.astro';
import { getNavHub } from '../../data/navigation';
import { getAllPublishedContent, getRelatedEntries, type AnyContentEntry } from '../../utils/content';

export async function getStaticPaths() {
  const hub = getNavHub('vpn');
  const all = await getAllPublishedContent();

  const subtopicPaths = hub.subtopics.map((sub) => ({
    params: { slug: sub.slug },
    props: { kind: 'subtopic' as const, sub, entry: null as AnyContentEntry | null, all },
  }));

  const articlePaths = all
    .filter((e) => e.data.urlPath.startsWith('/vpn/') && e.data.urlPath !== '/vpn/')
    .map((entry) => {
      const slug = entry.data.urlPath.replace(/^\/vpn\//, '').replace(/\/$/, '');
      return {
        params: { slug },
        props: { kind: 'article' as const, sub: null, entry, all },
      };
    });

  return [...subtopicPaths, ...articlePaths];
}

const { kind, sub, entry, all } = Astro.props;
const hub = getNavHub('vpn');

const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const headings = rendered?.headings || [];
const related = entry
  ? getRelatedEntries(entry.data.urlPath, all, entry.data.relatedSlugs, entry.data.category, 3)
  : [];

const relevantArticles = sub
  ? all.filter(
      (e) =>
        e.data.subtopic === sub.slug ||
        e.data.urlPath === sub.clusters[0]?.targetUrl ||
        e.data.urlPath === sub.clusters[1]?.targetUrl ||
        e.data.tags.some((t) => sub.title.includes(t) || t.includes(sub.title))
    )
  : [];
---

{kind === 'subtopic' && sub ? (
  <TopicLayout
    title={`${sub.title} — ${hub.title}二级专题`}
    description={sub.description}
    urlPath={sub.href}
    badgeText={`${hub.title} · 二级专题`}
    breadcrumbs={[
      { name: '首页', href: '/' },
      { name: hub.title, href: hub.href },
      { name: sub.title, href: sub.href },
    ]}
    clusters={sub.clusters}
    latestEntries={relevantArticles.length > 0 ? relevantArticles : all.slice(0, 3)}
    coreQuestions={[
      {
        q: `在「${sub.title}」场景下如何权衡安全与可用性？`,
        a: '选择协议前先明确使用设备（桌面/手机/路由器）和目标场景（远程办公、AI 开发或流媒体），优先选用开源可核实版本的客户端工具。',
      },
      {
        q: '免费 VPN 与付费代理服务的核心区别在哪里？',
        a: '服务器与国际带宽均存在刚性成本，免费工具通常伴随流量限速、广告注入或隐私条款风险，不建议在免费线路中登录重要账号。',
      },
    ]}
    nextLinks={[
      { title: '传统 VPN 与机场代理对比', href: '/comparisons/vpn-vs-airport-proxy/', desc: '理解协议抗干扰与规则分流差异。' },
      { title: 'iOS 移动端客户端配置指南', href: '/guides/ios-proxy-clients-guide/', desc: 'Shadowrocket、Stash 与 Karing 选型。' },
      { title: 'Clash Verge Rev 官方下载指南', href: '/clash/verge-official-download-guide/', desc: '桌面端开源客户端安全安装流程。' },
    ]}
  >
    <SubtopicGuideSection guideKey={`vpn/${sub.slug}`} />
  </TopicLayout>
) : entry && Content ? (
  <TutorialLayout
    title={entry.data.title}
    description={entry.data.description}
    urlPath={entry.data.urlPath}
    category={entry.data.category}
    pubDate={entry.data.pubDate}
    updatedDate={entry.data.updatedDate}
    author={entry.data.author}
    tags={entry.data.tags}
    platform={entry.data.platform}
    appVersion={entry.data.appVersion}
    sources={entry.data.sources}
    faqs={entry.data.faqs}
    headings={headings}
    bodyText={entry.body}
    relatedEntries={related}
    breadcrumbs={[
      { name: '首页', href: '/' },
      { name: hub.title, href: hub.href },
      { name: entry.data.title, href: entry.data.urlPath },
    ]}
  >
    <Content />
  </TutorialLayout>
) : null}
