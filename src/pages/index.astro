---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import BrandCard from '../components/commercial/BrandCard.astro';
import AffiliateDisclosure from '../components/commercial/AffiliateDisclosure.astro';
import { MAIN_NAVIGATION } from '../data/navigation';
import { ALL_BRANDS, getFeaturedBrands } from '../data/brands';
import { SITE_CONFIG } from '../data/site';
import { getAllPublishedContent, getPublishedTutorials, getPublishedReviews, getPublishedComparisons } from '../utils/content';

const [allContent, tutorials, reviews, comparisons] = await Promise.all([
  getAllPublishedContent(),
  getPublishedTutorials(),
  getPublishedReviews(),
  getPublishedComparisons(),
]);

const clashCoreTutorials = tutorials.filter((t) => t.data.urlPath.startsWith('/clash/')).slice(0, 6);
const featuredArticles = allContent.filter((e) => e.data.featured).slice(0, 3);
const troubleshootTutorials = tutorials
  .filter(
    (t) =>
      t.data.subtopic === 'troubleshooting' ||
      t.data.urlPath.includes('fix-') ||
      t.data.urlPath.includes('timeout') ||
      t.data.urlPath.includes('risk') ||
      t.data.urlPath.includes('tun')
  )
  .slice(0, 6);
const reviewAndCompList = [...reviews, ...comparisons].slice(0, 6);
const latestNine = allContent.slice(0, 9);
const spotlightBrands = getFeaturedBrands();

const homeFaqs = [
  {
    q: '机场优选（offerairport.cc）的核心内容结构是什么？',
    a: '全站严格采用「单站三分区」架构：教程区（/clash/、/guides/、/resources/）专注于解决软件安装、订阅导入与故障排查问题，不插入购买弹窗；评测对比区（/reviews/、/comparisons/）基于测速档案与品牌清单提供独立分析；商业品牌区（/brands/、/offers/）汇总透明套餐与合作链接。',
  },
  {
    q: '为什么部分品牌标示「年付折合 ¥5.6–8/月」而点进去需要付费近百元？',
    a: '因为这是年付套餐折算出的单月均价，并非可以按月购买的真实月付价。本站品牌库和评测表格中已将「年付折算月均价」与「真实月付价」明确拆分标识。',
  },
  {
    q: '新手应该先选机场，还是先安装客户端软件？',
    a: '建议先从官方开源渠道（GitHub Release）了解并安装 Clash Verge Rev 或对应手机客户端，掌握订阅导入和规则模式开关后，再先以单月或小额套餐实测晚高峰速度。',
  },
  {
    q: '商业推广合作会影响独立评测的结论吗？',
    a: '不会。本站虽然会将资料较完整且重点合作的品牌（如光速云）优先完善商业档案，但独立评测与横向对比均独立呈现优势、限制、测试时间戳与历史资料差异，商业推广优先级不等于实测第一名。',
  },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.domain,
    description: SITE_CONFIG.description,
    publishingPrinciples: `${SITE_CONFIG.domain}/methodology/`,
    correctionsPolicy: `${SITE_CONFIG.domain}/about/#corrections`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.domain,
    description: SITE_CONFIG.description,
    inLanguage: 'zh-CN',
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE_CONFIG.domain}/search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={`${SITE_CONFIG.name} — 中文代理客户端教程、独立评测与品牌套餐数据库`}
  description={SITE_CONFIG.description}
  canonicalUrl="/"
  structuredData={schemas}
>
  <!-- 2. Hero: Left Text + Right Observatory Knowledge Card -->
  <section class="bg-gradient-to-b from-bg-surface to-white border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-border-subtle text-xs font-medium text-text-title shadow-sm">
            <span class="w-2 h-2 rounded-full bg-brand-primary"></span>
            <span>教程、独立评测与品牌数据库三分区架构</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold text-text-title leading-[1.15] tracking-tight">
            把复杂代理配置讲清楚，<br class="hidden sm:inline" />
            用可核实数据看懂每家服务。
          </h1>

          <p class="text-base sm:text-lg text-text-body leading-relaxed max-w-2xl">
            {SITE_CONFIG.name}（offerairport.cc）致力于提供零水分的 Clash Verge Rev 与跨平台客户端中文实操手册、基于测速截图档案的独立对比，以及经过去重核对的 {ALL_BRANDS.length} 家机场品牌数据库。
          </p>

          <!-- Core Search Bar -->
          <form action="/search/" method="get" role="search" class="flex flex-col sm:flex-row gap-2.5 max-w-xl">
            <label for="hero-search" class="sr-only">搜索教程、客户端或品牌名称</label>
            <input
              id="hero-search"
              name="q"
              type="search"
              placeholder="搜教程 / 报错 / 品牌：Clash Verge 下载、TUN 模式、光速云..."
              class="flex-1 px-4 py-3 rounded-xl bg-white border border-border-subtle text-sm sm:text-base text-text-title shadow-sm focus:border-brand-primary"
            />
            <button
              type="submit"
              class="px-6 py-3 rounded-xl bg-brand-primary text-white font-semibold text-sm sm:text-base hover:bg-brand-primary-hover transition-colors shadow-sm shrink-0"
            >
              全文检索
            </button>
          </form>

          <!-- Quick Featured Tutorial Chips -->
          <div class="flex flex-wrap items-center gap-2 text-xs pt-1">
            <span class="text-text-muted font-medium">精选实操：</span>
            <a href="/clash/verge-official-download-guide/" class="px-3 py-1.5 rounded-lg bg-white border border-border-subtle text-text-title hover:border-brand-primary hover:text-brand-primary transition-colors">
              Clash Verge 官方下载
            </a>
            <a href="/clash/verge-subscription-import-guide/" class="px-3 py-1.5 rounded-lg bg-white border border-border-subtle text-text-title hover:border-brand-primary hover:text-brand-primary transition-colors">
              订阅导入教程
            </a>
            <a href="/clash/fix-node-timeout-errors/" class="px-3 py-1.5 rounded-lg bg-white border border-border-subtle text-text-title hover:border-brand-primary hover:text-brand-primary transition-colors">
              节点 Timeout 排障
            </a>
            <a href="/brands/" class="px-3 py-1.5 rounded-lg bg-brand-soft border border-blue-200 text-brand-primary font-medium hover:bg-blue-100 transition-colors">
              {ALL_BRANDS.length} 家品牌库 →
            </a>
          </div>
        </div>

        <!-- Right Visual Panel: Dark Observatory Summary Card -->
        <div class="lg:col-span-5">
          <div class="rounded-3xl bg-[#0B1220] text-slate-100 border border-slate-800 p-6 shadow-xl space-y-5">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3.5">
              <div>
                <div class="text-[11px] font-mono text-sky-400 uppercase tracking-wider">OfferAirport Observatory</div>
                <div class="text-base font-bold text-white mt-0.5">站点数据与内容覆盖概览</div>
              </div>
              <span class="px-2.5 py-1 rounded-full text-[11px] font-mono bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                Static Verified
              </span>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="bg-[#111A2E] rounded-xl p-3.5 border border-slate-800">
                <div class="text-slate-400 font-mono">独立审计品牌</div>
                <div class="text-2xl font-bold font-mono text-white mt-1">{ALL_BRANDS.length} 家</div>
                <div class="text-slate-400 mt-0.5">去重历史重复项</div>
              </div>
              <div class="bg-[#111A2E] rounded-xl p-3.5 border border-slate-800">
                <div class="text-slate-400 font-mono">已上线原创内容</div>
                <div class="text-2xl font-bold font-mono text-white mt-1">{allContent.length} 篇</div>
                <div class="text-slate-400 mt-0.5">教程 / 评测 / 横评</div>
              </div>
              <div class="bg-[#111A2E] rounded-xl p-3.5 border border-slate-800">
                <div class="text-slate-400 font-mono">专题导航体系</div>
                <div class="text-2xl font-bold font-mono text-white mt-1">4 × 7</div>
                <div class="text-slate-400 mt-0.5">4 大主栏 / 28 二级专题</div>
              </div>
              <div class="bg-[#111A2E] rounded-xl p-3.5 border border-slate-800">
                <div class="text-slate-400 font-mono">测速证据档案</div>
                <div class="text-2xl font-bold font-mono text-white mt-1">16+ 张</div>
                <div class="text-slate-400 mt-0.5">2026-08-11 原始截图</div>
              </div>
            </div>

            <div class="bg-[#111A2E] rounded-xl p-3.5 border border-slate-800 text-xs text-slate-300 leading-relaxed">
              <span class="text-sky-300 font-semibold">三分区承诺：</span>
              教程页不插商业推广按钮；评测页独立标注数据源与缺陷；商业页明确披露推广链接与年付折算口径。
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. 四大专题导航卡片 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <h2 class="text-2xl font-bold text-text-title">四大核心知识专题</h2>
        <p class="text-sm text-text-muted mt-1">覆盖 28 个二级专题与 56+ 三级内容集群，按问题直达对应栏目</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {MAIN_NAVIGATION.map((hub) => (
        <div class="card-elevated p-5 flex flex-col justify-between gap-4">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand-soft text-brand-primary flex items-center justify-center mb-3">
              {hub.icon === 'plane' && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                </svg>
              )}
              {hub.icon === 'shield' && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              )}
              {hub.icon === 'terminal' && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="4 17 10 11 4 5" />
                  <line x1="12" y1="19" x2="20" y2="19" />
                </svg>
              )}
              {hub.icon === 'radar' && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <circle cx="12" cy="12" r="3" />
                  <path d="M12 3v3M12 18v3M3 12h3M18 12h3" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-bold text-text-title mb-1.5">
              <a href={hub.href} class="hover:text-brand-primary transition-colors">
                {hub.title}
              </a>
            </h3>
            <p class="text-xs text-text-body leading-relaxed mb-3">{hub.shortDesc}</p>
            <div class="flex flex-wrap gap-1.5">
              {hub.subtopics.slice(0, 4).map((s) => (
                <a
                  href={s.href}
                  class="px-2 py-0.5 rounded-md bg-bg-surface border border-border-subtle text-[11px] text-text-body hover:border-brand-primary hover:text-brand-primary"
                >
                  {s.title}
                </a>
              ))}
            </div>
          </div>

          <a href={hub.href} class="text-xs font-semibold text-brand-primary hover:underline pt-2 border-t border-border-subtle">
            查看全部 {hub.subtopics.length} 个子专题 →
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. Clash Verge 核心教程 -->
  <section class="bg-bg-surface border-y border-border-subtle py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
          <span class="text-xs font-semibold text-brand-primary uppercase tracking-wider">Tutorial Zone · 无商业弹窗</span>
          <h2 class="text-2xl font-bold text-text-title mt-1">Clash Verge 核心实操教程</h2>
        </div>
        <a href="/clash/" class="text-sm font-semibold text-brand-primary hover:underline">
          进入 Clash 客户端专题 →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {clashCoreTutorials.map((entry) => (
          <ArticleCard
            title={entry.data.title}
            description={entry.data.description}
            urlPath={entry.data.urlPath}
            pageType={entry.data.pageType}
            category={entry.data.category}
            pubDate={entry.data.pubDate}
            updatedDate={entry.data.updatedDate}
            body={entry.body}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 5. 新手入门学习路径 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-text-title">新手 4 步入门学习路径</h2>
      <p class="text-sm text-text-muted mt-1">按「选软件 → 导订阅 → 调分流 → 会排障」顺序阅读，不走弯路</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {[
        {
          step: 'STEP 01',
          title: '下载正版开源客户端',
          desc: '学会辨别 GitHub 官方 Release 与钓鱼仿冒站，区分 Windows/macOS 架构。',
          href: '/clash/verge-official-download-guide/',
        },
        {
          step: 'STEP 02',
          title: '理解协议与导入订阅',
          desc: '导入标准 Clash YAML 订阅，设置自动更新与节点延迟测速。',
          href: '/clash/verge-subscription-import-guide/',
        },
        {
          step: 'STEP 03',
          title: '配置规则分流与 TUN',
          desc: '掌握 Rule 规则模式、DNS 防泄漏以及终端/游戏用的 TUN 虚拟网卡。',
          href: '/clash/tun-mode-udp-guide/',
        },
        {
          step: 'STEP 04',
          title: '学会自主排障与避险',
          desc: '遇到 Timeout 超时或订阅更新失败时，快速定位端口、时间或线路故障。',
          href: '/clash/fix-node-timeout-errors/',
        },
      ].map((item) => (
        <a href={item.href} class="card-elevated p-5 flex flex-col justify-between gap-3 group">
          <div>
            <span class="font-mono text-xs font-bold text-brand-primary">{item.step}</span>
            <h3 class="text-base font-bold text-text-title mt-1.5 mb-2 group-hover:text-brand-primary transition-colors">
              {item.title}
            </h3>
            <p class="text-sm text-text-body leading-relaxed">{item.desc}</p>
          </div>
          <span class="text-xs font-semibold text-brand-primary">开始这一步 →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 6. 编辑精选文章 & 7. 热门教程及故障排查 -->
  <section class="bg-bg-surface border-y border-border-subtle py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div>
        <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
          <div>
            <h2 class="text-2xl font-bold text-text-title">编辑精选深度内容</h2>
            <p class="text-sm text-text-muted mt-1">覆盖核心安装、协议对比与选型方法论的支柱型文章</p>
          </div>
          <a href="/guides/" class="text-sm font-semibold text-brand-primary hover:underline">全部实用指南 →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {featuredArticles.map((entry) => (
            <ArticleCard
              title={entry.data.title}
              description={entry.data.description}
              urlPath={entry.data.urlPath}
              pageType={entry.data.pageType}
              category={entry.data.category}
              pubDate={entry.data.pubDate}
              updatedDate={entry.data.updatedDate}
              body={entry.body}
            />
          ))}
        </div>
      </div>

      <div>
        <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
          <div>
            <h2 class="text-2xl font-bold text-text-title">热门教程与故障排查手册</h2>
            <p class="text-sm text-text-muted mt-1">解决节点超时、订阅失败、DNS 污染与跑路风险排查</p>
          </div>
          <a href="/clash/troubleshooting/" class="text-sm font-semibold text-brand-primary hover:underline">故障排查专题 →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {troubleshootTutorials.map((entry) => (
            <ArticleCard
              title={entry.data.title}
              description={entry.data.description}
              urlPath={entry.data.urlPath}
              pageType={entry.data.pageType}
              category={entry.data.category}
              pubDate={entry.data.pubDate}
              updatedDate={entry.data.updatedDate}
              body={entry.body}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 8. VPN 与加速器知识专题 & 9. 机场选择指南 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="rounded-3xl border border-border-subtle bg-white p-6 sm:p-7 space-y-4">
        <div class="flex items-center justify-between">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
            VPN 与加速器专题
          </span>
          <a href="/vpn/" class="text-xs font-semibold text-brand-primary hover:underline">进入专题 →</a>
        </div>
        <h2 class="text-xl font-bold text-text-title">理清 VPN、游戏加速器与规则代理的差异</h2>
        <p class="text-sm text-text-body leading-relaxed">
          覆盖 iOS（Shadowrocket / Stash / Quantumult X）与 Android（v2rayNG / FlClash）移动端配置，以及 IEPL 专线与公网 BGP 中转的技术对比。
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-sm">
          <a href="/comparisons/vpn-vs-airport-proxy/" class="p-3 rounded-xl bg-bg-surface hover:text-brand-primary font-medium">
            → VPN 与机场代理有什么区别？
          </a>
          <a href="/guides/ios-proxy-clients-guide/" class="p-3 rounded-xl bg-bg-surface hover:text-brand-primary font-medium">
            → iPhone 手机客户端选购与配置
          </a>
          <a href="/guides/android-proxy-clients-guide/" class="p-3 rounded-xl bg-bg-surface hover:text-brand-primary font-medium">
            → 安卓 v2rayNG 与 FlClash 指南
          </a>
          <a href="/comparisons/iepl-vs-bgp-transit/" class="p-3 rounded-xl bg-bg-surface hover:text-brand-primary font-medium">
            → IEPL 专线与 BGP 中转区别
          </a>
        </div>
      </div>

      <div class="rounded-3xl border border-border-subtle bg-white p-6 sm:p-7 space-y-4">
        <div class="flex items-center justify-between">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
            机场选择指南
          </span>
          <a href="/airport/" class="text-xs font-semibold text-brand-primary hover:underline">进入专题 →</a>
        </div>
        <h2 class="text-xl font-bold text-text-title">按预算与场景科学挑选机场服务</h2>
        <p class="text-sm text-text-body leading-relaxed">
          不迷信单一速度跑分。从个人月流量估算、月付验证习惯、不限时流量包适用度、以及跑路前兆排查四个维度建立选型清单。
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-sm">
