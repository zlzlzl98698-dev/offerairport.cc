---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import AffiliateDisclosure from '../../components/commercial/AffiliateDisclosure.astro';
import FaqAccordion from '../../components/common/FaqAccordion.astro';
import { ALL_BRANDS } from '../../data/brands';
import { SITE_CONFIG } from '../../data/site';
import { buildBreadcrumbSchema, buildCanonicalUrl, buildFaqSchema, type FAQItem } from '../../utils/seo';

const breadcrumbs = [
  { name: '首页', href: '/' },
  { name: '品牌数据库', href: '/brands/' },
];

const brandsFaqs: FAQItem[] = [
  {
    question: '为什么 32 家品牌数据库里既有「资料较全」也有「部分待核实」和「历史档案」？',
    answer:
      '本站依据本地原始清单、2026-08-11 测速快照以及后续专项截图分三层归档。缺少年月全周期价格表（例如仅见测速截图的快狸）或近半年缺乏连续复测的品牌均保持待核实/历史标注，拒绝用行业均值猜测补齐。',
  },
  {
    question: '数据库按价格筛选时，「10 元/月以下」的档位都可以只掏 10 块钱买一个月吗？',
    answer:
      '绝大多数不可以。标称 `¥5.6/月`、`¥7.4/月`、`¥8.25/月` 的入门门槛几乎全部属于「年付折算月均价」，需要一次预付全年 ¥67–¥99；真实单月按月购入价通常在 ¥18–¥27 起跳。',
  },
  {
    question: '使用 OpenWrt 软路由（OpenClash/Nikki）或 Clash Verge Rev 时应如何筛选？',
    answer:
      '请在上方「客户端支持」下拉框选中「含 Clash / 第三方订阅」，将所有「仅专属客户端」服务商过滤排除后，再核对协议及不限时容灾选项。',
  },
];

const title = `机场品牌数据库（${ALL_BRANDS.length} 家独立品牌档案、套餐与核实状态）`;
const description =
  `汇总整理并去重审计后的 ${ALL_BRANDS.length} 家机场品牌结构化数据库（含 31 家文本档案与 1 家测速截图待核实档案），支持按月付门槛、专线线路、客户端支持与是否含不限时流量包进行搜索、筛选与排序。`;

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: title,
    description,
    url: buildCanonicalUrl('/brands/'),
    numberOfItems: ALL_BRANDS.length,
    itemListElement: ALL_BRANDS.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: b.name,
      url: buildCanonicalUrl(`/brands/${b.slug}/`),
    })),
  },
  buildFaqSchema(brandsFaqs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl="/brands/"
  structuredData={schemas}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10" data-pagefind-body>
    <Breadcrumbs items={breadcrumbs} />

    <header class="rounded-3xl bg-bg-surface border border-border-subtle p-6 sm:p-8 mb-6">
      <div class="flex flex-wrap items-center gap-2 text-xs mb-3">
        <span class="px-2.5 py-0.5 rounded-full bg-slate-200 text-slate-800 font-semibold">
          商业品牌数据库
        </span>
        <span class="px-2.5 py-0.5 rounded-full bg-white border border-border-subtle text-text-muted font-mono">
          已审计收录：{ALL_BRANDS.length} 家独立品牌 · 更新：{SITE_CONFIG.lastUpdated}
        </span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-text-title mb-3">
        机场品牌与套餐数据库
      </h1>
      <p class="text-sm sm:text-base text-text-body max-w-3xl leading-relaxed">
        本库统一提取并审计本地品牌档案与 2026-08-11 测速快照。已明确区分「年付折算月均价」与「真实月付价」，未核实字段保留为待核实，绝不虚构测速或套餐数据。
      </p>
    </header>

    <div class="mb-6">
      <AffiliateDisclosure compact extraNote="品牌库排序仅反映资料完整度或筛选条件，不构成商业优先级排名；点击详情可查看完整套餐与风险提示。" />
    </div>

    <!-- Search, Filter & Sort Controls (Lightweight Vanilla JS) -->
    <section
      aria-label="品牌筛选工具"
      class="rounded-2xl border border-border-subtle bg-white p-4 sm:p-5 mb-8 shadow-sm"
      data-pagefind-ignore
    >
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">
        <div class="lg:col-span-2">
          <label for="brand-search" class="block text-xs font-semibold text-text-muted mb-1">
            搜索品牌 / 协议 / 关键词
          </label>
          <input
            id="brand-search"
            type="search"
            placeholder="例如：光速云、VLESS、Trojan、不限时..."
            class="w-full px-3.5 py-2 text-sm rounded-xl border border-border-subtle bg-bg-surface text-text-title focus:bg-white focus:border-brand-primary"
          />
        </div>

        <div>
          <label for="filter-price" class="block text-xs font-semibold text-text-muted mb-1">
            入门价格区间
          </label>
          <select
            id="filter-price"
            class="w-full px-3 py-2 text-sm rounded-xl border border-border-subtle bg-bg-surface text-text-title"
          >
            <option value="all">全部价格</option>
            <option value="under10">折合 ¥10/月以内</option>
            <option value="10to20">¥10–¥20/月区间</option>
            <option value="over20">¥20/月以上</option>
          </select>
        </div>

        <div>
          <label for="filter-line" class="block text-xs font-semibold text-text-muted mb-1">
            线路类型
          </label>
          <select
            id="filter-line"
            class="w-full px-3 py-2 text-sm rounded-xl border border-border-subtle bg-bg-surface text-text-title"
          >
            <option value="all">全部线路</option>
            <option value="IEPL">IEPL 专线</option>
            <option value="IPLC">IPLC 专线</option>
            <option value="BGP中转">BGP 中转/优化</option>
            <option value="原生IP">原生 IP</option>
          </select>
        </div>

        <div>
          <label for="filter-client" class="block text-xs font-semibold text-text-muted mb-1">
            客户端支持
          </label>
          <select
            id="filter-client"
            class="w-full px-3 py-2 text-sm rounded-xl border border-border-subtle bg-bg-surface text-text-title"
          >
            <option value="all">全部接入方式</option>
            <option value="third-party">支持第三方订阅 (Clash)</option>
            <option value="exclusive">仅专属客户端</option>
          </select>
        </div>

        <div>
          <label for="sort-brands" class="block text-xs font-semibold text-text-muted mb-1">
            排序方式
          </label>
          <select
            id="sort-brands"
            class="w-full px-3 py-2 text-sm rounded-xl border border-border-subtle bg-bg-surface text-text-title"
          >
            <option value="completeness">资料完整度优先</option>
            <option value="price-asc">入门门槛从低到高</option>
            <option value="price-desc">入门门槛从高到低</option>
            <option value="onetime">优先显示含不限时包</option>
          </select>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 mt-4 pt-3 border-t border-border-subtle text-xs">
        <div class="flex flex-wrap items-center gap-3">
          <label class="inline-flex items-center gap-1.5 cursor-pointer text-text-body">
            <input id="filter-onetime" type="checkbox" class="rounded border-slate-300 text-brand-primary" />
            <span>仅看支持「一次性不限时包」</span>
          </label>
          <label class="inline-flex items-center gap-1.5 cursor-pointer text-text-body">
            <input id="filter-speedtest" type="checkbox" class="rounded border-slate-300 text-brand-primary" />
            <span>仅看含 2026-08-11 测速截图档案</span>
          </label>
        </div>
        <div class="flex items-center gap-3">
          <span id="brand-count-label" class="font-mono text-text-muted">
            当前显示 {ALL_BRANDS.length} / {ALL_BRANDS.length} 家品牌
          </span>
          <button
            id="reset-filters-btn"
            type="button"
            class="text-brand-primary hover:underline font-medium"
          >
            重置筛选
          </button>
        </div>
      </div>
    </section>

    <!-- Brands Grid -->
    <div id="brands-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {ALL_BRANDS.map((brand, idx) => {
        const supportsThirdParty = brand.clientMode !== '仅专属客户端（无通用订阅）' && brand.clientMode !== '待核实';
        const isExclusiveOnly = brand.clientMode === '仅专属客户端（无通用订阅）';
        const hasScreenshot = Boolean(brand.speedReport?.screenshotPath);
        const searchIndex = [
          brand.name,
          brand.englishName,
          ...brand.aliases,
          brand.lineType,
          ...brand.protocols,
          brand.summary,
          brand.hasOnetimePlan ? '不限时' : '',
        ]
          .join(' ')
          .toLowerCase();

        return (
          <article
            class="brand-grid-item card-elevated p-5 flex flex-col justify-between h-full"
            data-index={idx}
            data-search={searchIndex}
            data-price={brand.startingMonthlyCny}
            data-lines={brand.lineTags.join(',')}
            data-third-party={supportsThirdParty ? '1' : '0'}
            data-exclusive={isExclusiveOnly ? '1' : '0'}
            data-onetime={brand.hasOnetimePlan ? '1' : '0'}
            data-screenshot={hasScreenshot ? '1' : '0'}
            data-completeness={brand.dataCompleteness === 'full' ? '3' : brand.dataCompleteness === 'partial' ? '2' : '1'}
          >
            <div>
              <div class="flex items-start justify-between gap-3 mb-3">
                <div class="flex items-center gap-3 min-w-0">
                  {brand.logo ? (
                    <img
                      src={brand.logo}
                      alt={`${brand.name} 图标`}
                      width="44"
                      height="44"
                      loading="lazy"
                      class="w-11 h-11 rounded-xl object-contain bg-bg-surface border border-border-subtle p-1 shrink-0"
                    />
                  ) : (
                    <div
                      class="w-11 h-11 rounded-xl flex items-center justify-center text-white font-bold text-sm shrink-0"
                      style={`background-color: ${brand.accentColor}`}
                    >
                      {brand.name.slice(0, 2)}
                    </div>
                  )}
                  <div class="min-w-0">
                    <h2 class="text-base font-bold text-text-title truncate">
                      <a href={`/brands/${brand.slug}/`} class="hover:text-brand-primary transition-colors">
                        {brand.name}
                      </a>
                    </h2>
                    <p class="text-xs text-text-muted truncate">
                      {brand.englishName} {brand.sinceYear ? `· ${brand.sinceYear} 年运营` : ''}
                    </p>
                  </div>
                </div>

                <span
                  class={`inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border shrink-0 ${
                    brand.dataCompleteness === 'full'
                      ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                      : brand.dataCompleteness === 'historical'
                        ? 'bg-amber-50 text-amber-700 border-amber-200'
                        : 'bg-slate-100 text-slate-700 border-slate-200'
                  }`}
                >
                  {brand.dataCompleteness === 'full'
                    ? '资料较全'
                    : brand.dataCompleteness === 'historical'
                      ? '历史档案'
                      : '部分待核实'}
                </span>
              </div>

              <p class="text-sm text-text-body leading-relaxed line-clamp-2 mb-3">
                {brand.summary}
              </p>

              <div class="space-y-1.5 text-xs bg-bg-surface rounded-xl p-3 mb-3 border border-border-subtle">
                <div class="flex justify-between gap-2">
                  <span class="text-text-muted">起步参考</span>
                  <span class="font-semibold text-text-title text-right">{brand.startingMonthlyDisplay}</span>
                </div>
                <div class="flex justify-between gap-2">
                  <span class="text-text-muted">线路 / 协议</span>
                  <span class="text-text-body text-right truncate max-w-[190px]">
                    {brand.lineTags.join('·')} / {brand.protocols[0]}
                  </span>
                </div>
                <div class="flex justify-between gap-2">
                  <span class="text-text-muted">客户端</span>
                  <span class="text-text-body text-right">{brand.clientMode}</span>
                </div>
              </div>

              <div class="flex flex-wrap gap-1.5 mb-4">
                {brand.hasOnetimePlan && (
                  <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 text-[11px] font-medium">
                    含不限时包
                  </span>
                )}
                {hasScreenshot && (
                  <span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 text-[11px] font-medium">
                    有实测截图
                  </span>
                )}
                {brand.promoCode && (
                  <span class="px-2 py-0.5 rounded-md bg-bg-surface border border-border-subtle text-text-muted font-mono text-[11px]">
                    码: {brand.promoCode}
                  </span>
                )}
              </div>
            </div>

            <div class="pt-3 border-t border-border-subtle flex items-center justify-between gap-2 text-xs">
              <a
                href={`/brands/${brand.slug}/`}
                class="font-semibold text-brand-primary hover:underline"
              >
                查看套餐与档案 →
              </a>
              <span class="font-mono text-text-muted">核实：{brand.verifiedAt}</span>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Empty State -->
    <div
      id="brands-empty-state"
      class="hidden rounded-2xl border border-border-subtle bg-bg-surface p-10 text-center space-y-3 mt-6"
    >
      <p class="text-base font-bold text-text-title">没有符合当前筛选条件的品牌</p>
      <p class="text-sm text-text-muted">
        请尝试放宽价格区间或取消勾选特定限制条件。
      </p>
      <button
        id="empty-reset-btn"
        type="button"
        class="px-4 py-2 rounded-xl bg-brand-primary text-white text-sm font-semibold"
      >
        重置全部筛选条件
      </button>
    </div>

    <FaqAccordion title="品牌数据库筛选与数据解读 FAQ" faqs={brandsFaqs} />
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('brand-search') as HTMLInputElement | null;
  const priceSelect = document.getElementById('filter-price') as HTMLSelectElement | null;
  const lineSelect = document.getElementById('filter-line') as HTMLSelectElement | null;
  const clientSelect = document.getElementById('filter-client') as HTMLSelectElement | null;
  const sortSelect = document.getElementById('sort-brands') as HTMLSelectElement | null;
  const onetimeCheck = document.getElementById('filter-onetime') as HTMLInputElement | null;
  const speedtestCheck = document.getElementById('filter-speedtest') as HTMLInputElement | null;
  const grid = document.getElementById('brands-grid');
  const emptyState = document.getElementById('brands-empty-state');
  const countLabel = document.getElementById('brand-count-label');
  const resetBtn = document.getElementById('reset-filters-btn');
  const emptyResetBtn = document.getElementById('empty-reset-btn');

  const items = Array.from(document.querySelectorAll<HTMLElement>('.brand-grid-item'));

  function applyFiltersAndSort() {
    const q = (searchInput?.value || '').trim().toLowerCase();
    const price = priceSelect?.value || 'all';
    const line = lineSelect?.value || 'all';
    const client = clientSelect?.value || 'all';
    const sortBy = sortSelect?.value || 'completeness';
    const onlyOnetime = Boolean(onetimeCheck?.checked);
    const onlySpeed = Boolean(speedtestCheck?.checked);

    let visibleCount = 0;

    items.forEach((el) => {
      const searchStr = el.dataset.search || '';
      const itemPrice = Number(el.dataset.price || '0');
      const lines = (el.dataset.lines || '').split(',');
      const isThird = el.dataset.thirdParty === '1';
      const isExcl = el.dataset.exclusive === '1';
      const hasOnetime = el.dataset.onetime === '1';
      const hasShot = el.dataset.screenshot === '1';

      let show = true;
      if (q && !searchStr.includes(q)) show = false;
      if (price === 'under10' && itemPrice > 10) show = false;
      if (price === '10to20' && (itemPrice <= 10 || itemPrice > 20)) show = false;
      if (price === 'over20' && (itemPrice <= 20 || itemPrice >= 900)) show = false;
      if (line !== 'all' && !lines.includes(line)) show = false;
      if (client === 'third-party' && !isThird) show = false;
      if (client === 'exclusive' && !isExcl) show = false;
      if (onlyOnetime && !hasOnetime) show = false;
      if (onlySpeed && !hasShot) show = false;

      el.classList.toggle('hidden', !show);
      if (show) visibleCount += 1;
    });

    // Sort DOM nodes inside grid
    if (grid) {
      const sorted = [...items].sort((a, b) => {
        if (sortBy === 'price-asc') {
          return Number(a.dataset.price || 0) - Number(b.dataset.price || 0);
        }
        if (sortBy === 'price-desc') {
          return Number(b.dataset.price || 0) - Number(a.dataset.price || 0);
        }
        if (sortBy === 'onetime') {
          const diff = Number(b.dataset.onetime || 0) - Number(a.dataset.onetime || 0);
          return diff !== 0 ? diff : Number(a.dataset.index || 0) - Number(b.dataset.index || 0);
        }
        const compDiff = Number(b.dataset.completeness || 0) - Number(a.dataset.completeness || 0);
        return compDiff !== 0 ? compDiff : Number(a.dataset.index || 0) - Number(b.dataset.index || 0);
      });
      sorted.forEach((node) => grid.appendChild(node));
    }

    if (countLabel) {
      countLabel.textContent = `当前显示 ${visibleCount} / ${items.length} 家品牌`;
    }
    emptyState?.classList.toggle('hidden', visibleCount > 0);
  }

  function resetAll() {
    if (searchInput) searchInput.value = '';
    if (priceSelect) priceSelect.value = 'all';
    if (lineSelect) lineSelect.value = 'all';
    if (clientSelect) clientSelect.value = 'all';
    if (sortSelect) sortSelect.value = 'completeness';
    if (onetimeCheck) onetimeCheck.checked = false;
    if (speedtestCheck) speedtestCheck.checked = false;
    applyFiltersAndSort();
  }

  [searchInput, priceSelect, lineSelect, clientSelect, sortSelect, onetimeCheck, speedtestCheck].forEach((el) => {
    el?.addEventListener('input', applyFiltersAndSort);
    el?.addEventListener('change', applyFiltersAndSort);
  });

  resetBtn?.addEventListener('click', resetAll);
  emptyResetBtn?.addEventListener('click', resetAll);
</script>
