---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import AffiliateDisclosure from '../../components/commercial/AffiliateDisclosure.astro';
import FaqAccordion from '../../components/common/FaqAccordion.astro';
import { getPublishedReviews } from '../../utils/content';
import { buildBreadcrumbSchema, buildCanonicalUrl, buildFaqSchema, type FAQItem } from '../../utils/seo';

const reviews = await getPublishedReviews();

const breadcrumbs = [
  { name: '首页', href: '/' },
  { name: '独立评测', href: '/reviews/' },
];

const reviewsFaqs: FAQItem[] = [
  {
    question: '独立评测如何做到「商业合作不影响结论」？',
    answer:
      '每篇评测顶部先呈现实测结论、限制及不适合人群；保留测试图里的 `0B` 超时样本、标清非晚高峰样本范围（如 2026-10-19 参考数据），且全站拒绝编造虚假 `4.9/5` 星级评分。',
  },
  {
    question: '在站内看到「数据透明度审计」和「快狸与历史品牌核验」有什么作用？',
    answer:
      '用于帮用户识破同质化文案集群（如 ¥5.6/月档）、核清仅有单次测速截图却缺官方价目的品牌真实证据边界，从而避免冲动预付多年款。',
  },
  {
    question: '读完评测后确定想测试一家品牌，最优下单流程是什么？',
    answer:
      '务必先核实是否支持你所在设备的客户端（例如软路由玩家避开仅专属客户端），优先选购可单月结账的最低入门包连续验证两天晚高峰（20:00–23:00）再考虑长周期。',
  },
];

const title = '独立深度评测专栏 — 基于可核实证据的机场与客户端评估';
const description =
  '坚持「证据优先、优缺点并陈、商业合作不决定评测排名」的原则，提供光速云等热门品牌深度评测、选型方法论与资料透明度审计。';

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: buildCanonicalUrl('/reviews/'),
  },
  buildFaqSchema(reviewsFaqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl="/reviews/" structuredData={schemas}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10" data-pagefind-body>
    <Breadcrumbs items={breadcrumbs} />

    <header class="rounded-3xl bg-bg-surface border border-border-subtle p-6 sm:p-8 mb-6">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-3">
        独立评测与对比区
      </span>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-text-title mb-3">
        独立深度评测专栏
      </h1>
      <p class="text-sm sm:text-base text-text-body max-w-3xl leading-relaxed">
        所有评测均注明资料来源、测试快照日期及限制条件。商业优先合作关系明确披露，绝不将未经核实的商家宣传直接写为独立实测结论。
      </p>
    </header>

    <div class="mb-6">
      <AffiliateDisclosure compact />
    </div>

    <section class="mb-8 rounded-2xl border border-border-subtle bg-white overflow-hidden">
      <div class="px-5 py-3.5 bg-bg-surface border-b border-border-subtle text-sm font-bold text-text-title">
        独立评测必读导航（方法论 · 品牌单测 · 资料审计）
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[560px] lg:min-w-0 text-left border-collapse text-xs sm:text-[13px]">
          <thead>
            <tr class="bg-bg-surface/60 border-b border-border-subtle text-text-title">
              <th class="p-3 font-bold">评测类别</th>
              <th class="p-3 font-bold">核心解决疑问</th>
              <th class="p-3 font-bold">代表入口</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-subtle text-text-body">
            <tr>
              <td class="p-3 font-semibold text-text-title">选型原则与专项审计</td>
              <td class="p-3">搞清不限时流量成本账、识别品牌同质化与缺口</td>
              <td class="p-3"><a href="/reviews/2026-airport-selection-methodology/" class="text-brand-primary font-semibold hover:underline">选型方法论 →</a> / <a href="/reviews/brand-data-transparency-audit/" class="text-brand-primary font-semibold hover:underline">透明度审计 →</a></td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-text-title">高关注度单品牌实测剖析</td>
              <td class="p-3">看清各品牌真实档位、缺点边界与实测快照细节</td>
              <td class="p-3"><a href="/reviews/guangsuyun-deep-review/" class="text-brand-primary font-semibold hover:underline">光速云 →</a> / <a href="/reviews/weitu-review/" class="text-brand-primary font-semibold hover:underline">唯兔云 →</a> / <a href="/reviews/yifan-review/" class="text-brand-primary font-semibold hover:underline">一翻云 →</a></td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-text-title">专项工具与轻量化场景</td>
              <td class="p-3">iOS 付费软件值不值、轻量学生包与企业合规办公</td>
              <td class="p-3"><a href="/reviews/ios-proxy-apps-review/" class="text-brand-primary font-semibold hover:underline">iOS 软件评测 →</a> / <a href="/reviews/onetime-traffic-airports-guide/" class="text-brand-primary font-semibold hover:underline">不限时专题 →</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((entry) => (
        <ArticleCard
          title={entry.data.title}
          description={entry.data.description}
          urlPath={entry.data.urlPath}
          pageType={entry.data.pageType}
          category={entry.data.category}
          pubDate={entry.data.pubDate}
          updatedDate={entry.data.updatedDate}
          body={entry.body}
        />
      ))}
    </div>

    <FaqAccordion title="独立评测专栏常见问询 FAQ" faqs={reviewsFaqs} />
  </div>
</BaseLayout>
