---
import { render } from 'astro:content';
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import { getAllPublishedContent, getPublishedReviews, getRelatedEntries } from '../../utils/content';

export async function getStaticPaths() {
  const [reviews, all] = await Promise.all([getPublishedReviews(), getAllPublishedContent()]);
  return reviews.map((entry) => {
    const slug = entry.data.urlPath.replace(/^\/reviews\//, '').replace(/\/$/, '');
    return {
      params: { slug },
      props: { entry, all },
    };
  });
}

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const related = getRelatedEntries(entry.data.urlPath, all, entry.data.relatedSlugs, entry.data.category, 3);
---

<ReviewLayout
  title={entry.data.title}
  description={entry.data.description}
  urlPath={entry.data.urlPath}
  category={entry.data.category}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  verifiedAt={entry.data.verifiedAt}
  author={entry.data.author}
  tags={entry.data.tags}
  brandSlugs={entry.data.brandSlugs}
  pros={entry.data.pros}
  cons={entry.data.cons}
  suitableFor={entry.data.suitableFor}
  notSuitableFor={entry.data.notSuitableFor}
  verdict={entry.data.verdict}
  sources={entry.data.sources}
  faqs={entry.data.faqs}
  headings={headings}
  relatedEntries={related}
  breadcrumbs={[
    { name: '首页', href: '/' },
    { name: '独立评测', href: '/reviews/' },
    { name: entry.data.title, href: entry.data.urlPath },
  ]}
>
  <Content />
</ReviewLayout>
