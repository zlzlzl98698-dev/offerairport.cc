---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import TableOfContents from '../../components/common/TableOfContents.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getNavHub } from '../../data/navigation';
import { getAllPublishedContent } from '../../utils/content';
import { SITE_CONFIG } from '../../data/site';
import { buildBreadcrumbSchema, buildCanonicalUrl } from '../../utils/seo';
import {
  CLASH_PLATFORM_MATRIX,
  DESKTOP_DEEP_COMPARISON,
  PROXY_MODE_COMPARISON,
  CLASH_DECISION_BRANCHES,
  CLASH_ACTION_CARDS,
  CLASH_HUB_FAQS,
  CLASH_INTERNAL_CLUSTER_LINKS,
} from '../../data/clash-hub-upgrade';

const hub = getNavHub('clash');
const urlPath = hub.href;
const title = `${hub.title}专题 — Clash Verge Rev 官方下载、配置与故障排查`;
const description =
  '围绕 Clash 客户端停更后的安全替代、Clash Verge Rev / FlClash / v2rayN 全平台选型对比、GitHub 官方校验下载、订阅导入与转换、TUN 模式与 Fake-IP DNS 防泄漏配置，以及全节点 Timeout 与 403 故障排查的专著级技术手册。';

const verifiedDate = '2026-11-20';

const all = await getAllPublishedContent();
const relevant = all.filter((e) => e.data.urlPath.startsWith('/clash/'));
const featured = relevant.filter((e) => e.data.featured).slice(0, 4);

const breadcrumbs = [
  { name: '首页', href: '/' },
  { name: hub.title, href: urlPath },
];

const headings = [
  { depth: 2, slug: 'client-matrix', text: '一、全平台 Clash 与现代兼容客户端推荐对比表' },
  { depth: 3, slug: 'desktop-deep-compare', text: '桌面主力客户端架构、服务模式与覆写能力对比' },
  { depth: 3, slug: 'mode-protocol-compare', text: '工作模式、路由规则、DNS 映射与内核代际核心对比' },
  { depth: 2, slug: 'official-download', text: '二、官方安全下载、CPU 架构识别、校验与旧版迁移' },
  { depth: 3, slug: 'avoid-fake-sites', text: '为什么搜“Clash 官网”容易中招：识破仿冒域名与捆绑包' },
  { depth: 3, slug: 'os-arch-and-checksum', text: 'Windows / macOS / Linux / 移动端架构区分与哈希校验' },
  { depth: 3, slug: 'migrate-from-cfw', text: '从已停更的 Clash for Windows / ClashX 平滑迁移步骤' },
  { depth: 2, slug: 'subscription-workflow', text: '三、订阅导入、格式转换、User-Agent 与策略组实战' },
  { depth: 3, slug: 'import-and-ua', text: '一键导入 vs 手动粘贴：看懂订阅头、剩余流量与 UA 识别' },
  { depth: 3, slug: 'format-conversion-security', text: '通用链接 / Base64 转 Clash YAML 与 Sub-Store 安全边界' },
  { depth: 3, slug: 'profiles-and-groups', text: '策略组测速逻辑、手动切换与自动选择（url-test）的取舍' },
  { depth: 2, slug: 'system-proxy-vs-tun', text: '四、系统代理 vs TUN 虚拟网卡、UWP 豁免与 UDP 转发' },
  { depth: 3, slug: 'when-tun-required', text: '为什么浏览器正常而终端 git/npm/Docker 与游戏必须开 TUN？' },
  { depth: 3, slug: 'service-mode-and-uwp', text: 'Windows 服务模式安装、UWP 回环豁免与 macOS 增强授权' },
  { depth: 3, slug: 'udp-and-routing-discipline', text: 'UDP 转发、FullCone NAT 联机以及 Rule / Global 日常使用纪律' },
  { depth: 2, slug: 'mihomo-dns-rules', text: '五、Mihomo 内核、DNS 防泄漏与 AI/流媒体分流规则' },
  { depth: 3, slug: 'fakeip-vs-redirhost', text: 'Fake-IP 与 Redir-Host 机制差异及内网域名放行列表' },
  { depth: 3, slug: 'dns-leak-and-ipv6', text: '国内外 DNS 拆分、Sniffer 域名嗅探与 IPv6 双栈冲突排查' },
  { depth: 3, slug: 'ai-and-override-rules', text: '通过 Merge 与 JS 扩展覆写实现 AI 工具与流媒体独立分流' },
  { depth: 2, slug: 'troubleshooting-handbook', text: '六、高频故障排查手册：全节点 Timeout 九步法与订阅报错' },
  { depth: 3, slug: 'nine-step-timeout', text: '全部节点绿字却 Timeout 或无法打开网页的九步排查顺序' },
  { depth: 3, slug: 'sub-update-errors', text: '订阅下载与更新失败（403 / TLS / 超时 / 代理死循环）处置' },
  { depth: 3, slug: 'yaml-and-lan-errors', text: '配置文件 YAML 语法报错、端口冲突与局域网共享失效排查' },
  { depth: 2, slug: 'openwrt-and-scenarios', text: '七、OpenWrt 软路由、Linux 服务端与四类人群决策分支' },
  { depth: 3, slug: 'openwrt-plugins-guide', text: 'OpenClash、Nikki（OpenWrt 24.10+）与 PassWall2 软路由选型要点' },
  { depth: 3, slug: 'scenario-branches', text: '按使用系统、技术习惯与场景划分的四条可执行分支' },
  { depth: 2, slug: 'next-steps-and-brands', text: '八、获取客户端、操作教程与二级子专题导航（共 7 个子栏目）' },
  { depth: 2, slug: 'faq', text: '九、Clash 客户端高频边界问题 FAQ（9 问）' },
  { depth: 2, slug: 'related-clusters', text: '十、站内专题教程簇与推荐深度阅读' },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: buildCanonicalUrl(urlPath),
    inLanguage: 'zh-CN',
    dateModified: verifiedDate,
    author: {
      '@type': 'Organization',
      name: SITE_CONFIG.author,
    },
    isPartOf: {
      '@type': 'WebSite',
      name: SITE_CONFIG.name,
      url: SITE_CONFIG.domain,
    },
    hasPart: hub.subtopics.map((s) => ({
      '@type': 'CollectionPage',
      name: s.title,
      url: buildCanonicalUrl(s.href),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: CLASH_HUB_FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={urlPath}
  ogType="article"
  author={SITE_CONFIG.author}
  publishDate="2026-10-15T00:00:00Z"
  modifiedDate={`${verifiedDate}T18:35:00+08:00`}
  tags={['Clash客户端', 'Clash Verge Rev', 'Mihomo内核', 'Clash下载', 'TUN模式', 'DNS防泄漏', 'Clash排障']}
  structuredData={schemas}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Main Monograph Article Column -->
      <article class="lg:col-span-8 min-w-0 space-y-10" data-pagefind-body>
        <!-- Header & Answer-First Executive Summary -->
        <header class="rounded-3xl bg-bg-surface border border-border-subtle p-6 sm:p-8 space-y-5">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="px-2.5 py-1 rounded-full bg-brand-soft text-brand-primary border border-blue-200 font-semibold">
              一级导航专题 ③ · 教程与知识区
            </span>
            <span class="px-2.5 py-1 rounded-full bg-white text-text-title border border-border-subtle font-mono">
              最近核实：{verifiedDate}
            </span>
            <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-medium">
              开源通用客户端体系 · 不捆绑节点
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-text-title tracking-tight leading-tight">
            {title}
          </h1>

          <p class="text-sm sm:text-base text-text-body leading-relaxed">
            原版 Clash 内核与 Clash for Windows 已于 2023 年 11 月正式停止维护。本专题面向当前真实网络环境，系统整理 Windows、macOS、Linux、Android、iOS 与 OpenWrt 软路由仍在持续维护的替代客户端，给出官方安全校验下载路径、订阅导入与转换方法、TUN 与 Fake-IP 核心配置逻辑，以及高频报错的逐层排障步骤。
          </p>

          <!-- Answer-First Executive Card -->
          <div class="rounded-2xl bg-white border border-blue-200 p-5 space-y-3 shadow-xs">
            <div class="flex items-center gap-2 text-sm font-bold text-brand-primary">
              <span>直接结论（先看这里）</span>
            </div>
            <ul class="space-y-2 text-sm text-text-body leading-relaxed list-disc pl-5">
              <li>
                <strong>桌面端首选客户端：</strong>Windows、macOS 与 Linux 用户优先选择基于 <strong>Mihomo（原 Clash.Meta）</strong> 内核且持续维护的 <strong>Clash Verge Rev</strong>；跨桌面与安卓统一视觉习惯可选 <strong>FlClash</strong>；熟悉多协议调试的高级玩家可选支持多内核调度的 <strong>v2rayN</strong> 或 <strong>Clash Nyanpasu</strong>。
              </li>
              <li>
                <strong>下载与安全底线：</strong>切勿在搜索引擎竞价广告中搜索“Clash 官网”下载来路不明的 EXE/DMG，也不要继续找所谓的“Clash for Windows 汉化破解版”；所有开源客户端均应核对官方 GitHub Releases 与 SHA256 校验值，macOS 必须严格区分 Intel（x64）与 Apple Silicon（aarch64/arm64）。
              </li>
              <li>
                <strong>标准配置路线：</strong>安装客户端 → 导入服务商提供的 Clash/Mihomo 专用 YAML 订阅 → 保持 <strong>Rule（规则模式）</strong> 并开启「系统代理」完成网页分流 → 仅当终端（git/npm/curl）、Docker、游戏客户端或微软商店应用不走代理时，再授权「服务模式」并打开 <strong>TUN 虚拟网卡</strong>。
              </li>
              <li>
                <strong>客户端与节点分离边界：</strong>所有主流开源 Clash 客户端均为空白调度工具，本身不包含任何可用服务器线路。如需评估订阅兼容、专线与公网中转差距，可通过下方专设入口跳转至独立评测与品牌筛选库。
              </li>
            </ul>
            <div class="pt-1 flex flex-wrap gap-2.5 text-xs">
              <a
                href="#client-matrix"
                class="px-3.5 py-2 rounded-xl bg-brand-primary text-white font-semibold hover:bg-brand-primary-hover transition-colors"
              >
                查看全平台选型对比表
              </a>
              <a
                href="#official-download"
                class="px-3.5 py-2 rounded-xl bg-bg-surface text-text-title border border-border-subtle font-semibold hover:border-brand-primary transition-colors"
              >
                核对下载校验与迁移
              </a>
              <a
                href="#troubleshooting-handbook"
                class="px-3.5 py-2 rounded-xl bg-bg-surface text-text-title border border-border-subtle font-semibold hover:border-brand-primary transition-colors"
              >
                Timeout / 订阅报错排障
              </a>
            </div>
          </div>

          <!-- Mobile Collapsible TOC -->
          <div class="lg:hidden">
            <details class="rounded-2xl border border-border-subtle bg-white p-4">
              <summary class="text-sm font-bold text-text-title cursor-pointer flex items-center justify-between">
                <span>本页完整章节目录（共 10 章）</span>
                <span class="text-xs font-normal text-brand-primary">点击展开</span>
              </summary>
              <nav class="mt-3 space-y-1.5 text-xs border-t border-border-subtle pt-3">
                {headings.map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class:list={[
                      'block py-1 hover:text-brand-primary transition-colors',
                      h.depth === 2 ? 'font-semibold text-text-title' : 'pl-3 text-text-muted',
                    ]}
                  >
                    {h.text}
                  </a>
                ))}
              </nav>
            </details>
          </div>
        </header>

        <!-- Section 1: Cross-Platform Comparison Matrix -->
        <section id="client-matrix" class="scroll-mt-24 space-y-6">
          <h2 class="text-xl sm:text-2xl font-bold text-text-title pb-2.5 border-b border-border-subtle">
            一、全平台 Clash 与现代兼容客户端推荐对比表
          </h2>
          <p class="text-sm sm:text-base text-text-body leading-relaxed">
            许多初次接触代理软件的用户习惯把所有分流软件统称为“Clash”，但事实上在原版 Clash 仓库归档之后，真正承担现代协议解析任务的是 <strong>Mihomo（原 Clash.Meta）</strong> 与 <strong>sing-box</strong> 两套开源内核。不同操作系统的硬件权限、后台保活机制与商店分发政策差异极大，因此并不存在“全平台只装某一个软件就能一劳永逸”的方案。下表依据系统支持、底层内核、包格式、订阅兼容性与当前已知维护边界整理而成，便于你先按设备锁定候选工具。
          </p>

          <div class="rounded-2xl border border-border-subtle bg-white overflow-hidden">
            <div class="px-4 py-3 bg-bg-surface border-b border-border-subtle flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm font-bold text-text-title">表 1：全平台活跃维护与兼容客户端总矩阵（Windows / Mac / Linux / 移动 / 软路由）</span>
              <span class="text-xs text-text-muted sm:hidden">左右滑动查看完整列 →</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[620px] lg:min-w-0 text-left border-collapse text-xs sm:text-[13px]">
                <thead>
                  <tr class="bg-bg-surface/70 border-b border-border-subtle text-text-title">
                    <th class="p-3 sm:p-3.5 font-bold w-[22%]">客户端与覆盖平台</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[25%]">底层内核与包格式 / 架构</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[25%]">订阅与格式支持</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[28%]">维护状态与适用注意项</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle text-text-body">
                  {CLASH_PLATFORM_MATRIX.map((row) => (
                    <tr class="hover:bg-slate-50/70 align-top">
                      <td class="p-3 sm:p-3.5 leading-relaxed space-y-1">
                        <a href={row.detailHref} class="font-bold text-brand-primary hover:underline text-sm">
                          {row.name}
                        </a>
                        <div class="text-xs font-medium text-text-title">{row.platform}</div>
                        <div class="text-[11px] text-text-muted">{row.targetUser}</div>
                      </td>
                      <td class="p-3 sm:p-3.5 leading-relaxed space-y-1">
                        <div class="font-semibold text-text-title">{row.core}</div>
                        <div class="text-xs text-text-muted">{row.archOrFormat}</div>
                      </td>
                      <td class="p-3 sm:p-3.5 leading-relaxed">{row.subscriptionSupport}</td>
                      <td class="p-3 sm:p-3.5 leading-relaxed">{row.maintenanceAndCaveats}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <p class="text-xs text-text-muted leading-relaxed">
            注：在 Android 生态中，部分早期流行工具（如 NekoBox for Android）原作者维护更新有限，且第三方应用商店（含部分 Google Play 挂名发行版本）曾被曝光存在非原作者接管争议；因此移动端选型优先推荐活跃仓库直出的 FlClash、Clash Meta for Android、v2rayNG、SFA、Hiddify 或 Karing。
          </p>

          <h3 id="desktop-deep-compare" class="text-lg sm:text-xl font-bold text-text-title pt-2">
            桌面主力客户端架构、服务模式与覆写能力对比
          </h3>
          <p class="text-sm sm:text-base text-text-body leading-relaxed">
            即使同在桌面端且都支持 Mihomo 内核，不同前端 GUI 在内存占用、虚拟网卡授权稳定性以及规则二次修改（覆写）能力上依然拉开了明显差距。对长期挂在后台运行的办公电脑和笔记本来说，基于 Electron 框架的旧式桌面端往往常驻占用数百兆内存且唤醒延迟较高；而采用 Tauri 或 Flutter 构建的新一代客户端，则在启动速度和常驻内存上控制得更好。
          </p>

          <div class="rounded-2xl border border-border-subtle bg-white overflow-hidden">
            <div class="px-4 py-3 bg-bg-surface border-b border-border-subtle flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm font-bold text-text-title">表 2：桌面主力客户端前端架构、TUN 服务权限与覆写能力对比</span>
              <span class="text-xs text-text-muted sm:hidden">左右滑动查看完整列 →</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[600px] lg:min-w-0 text-left border-collapse text-xs sm:text-[13px]">
                <thead>
                  <tr class="bg-bg-surface/70 border-b border-border-subtle text-text-title">
                    <th class="p-3 sm:p-3.5 font-bold w-[22%]">客户端与前端栈</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[26%]">TUN 与系统服务权限</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[26%]">配置覆写与脚本能力</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[26%]">适用人群与维护状态</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle text-text-body">
                  {DESKTOP_DEEP_COMPARISON.map((row) => (
                    <tr class="hover:bg-slate-50/70 align-top">
                      <td class="p-3 sm:p-3.5 leading-relaxed space-y-1">
                        <div class="font-bold text-text-title text-sm">{row.client}</div>
                        <div class="text-xs text-brand-primary font-medium">{row.coreEngine}</div>
                        <div class="text-[11px] text-text-muted">{row.uiStack}</div>
                      </td>
                      <td class="p-3 sm:p-3.5 leading-relaxed">{row.tunAndService}</td>
                      <td class="p-3 sm:p-3.5 leading-relaxed">{row.overrideCapability}</td>
                      <td class="p-3 sm:p-3.5 leading-relaxed space-y-1">
                        <div class="font-semibold text-text-title">{row.status}</div>
                        <div class="text-xs text-text-muted">{row.bestFor}</div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <h3 id="mode-protocol-compare" class="text-lg sm:text-xl font-bold text-text-title pt-2">
            工作模式、路由规则、DNS 映射与内核代际核心对比
          </h3>
          <p class="text-sm sm:text-base text-text-body leading-relaxed">
            超过八成的所谓“软件不好用”或“打开代理后国内网站变慢”，本质上不是软件有 Bug，而是使用者把几组关键机制混为一谈：把系统代理当成全局接管、把 Global 全局模式当成日常分流、在不知情的情况下继续运行不支持 Hysteria2/Reality 的停更内核，或者误关闭了 Fake-IP 导致域名解析频繁被本地抢答污染。下表将这四组核心概念压缩在同一维度做对照。
          </p>

          <div class="rounded-2xl border border-border-subtle bg-white overflow-hidden">
            <div class="px-4 py-3 bg-bg-surface border-b border-border-subtle flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm font-bold text-text-title">表 3：工作模式、出站路由、Fake-IP 与内核代际四维对照</span>
              <span class="text-xs text-text-muted sm:hidden">左右滑动查看完整列 →</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[600px] lg:min-w-0 text-left border-collapse text-xs sm:text-[13px]">
                <thead>
                  <tr class="bg-bg-surface/70 border-b border-border-subtle text-text-title">
                    <th class="p-3 sm:p-3.5 font-bold w-[20%]">技术决策维度</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[28%]">方案 A（默认 / 推荐理解）</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[26%]">方案 B（特定场景 / 误区）</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[26%]">工程建议与判定边界</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle text-text-body">
                  {PROXY_MODE_COMPARISON.map((row) => (
                    <tr class="hover:bg-slate-50/70 align-top">
                      <td class="p-3 sm:p-3.5 font-bold text-text-title leading-relaxed">{row.dimension}</td>
                      <td class="p-3 sm:p-3.5 leading-relaxed">{row.optionA}</td>
