---
import { render } from 'astro:content';
import TopicLayout from '../../layouts/TopicLayout.astro';
import TutorialLayout from '../../layouts/TutorialLayout.astro';
import BrandCard from '../../components/commercial/BrandCard.astro';
import SubtopicGuideSection from '../../components/common/SubtopicGuideSection.astro';
import { getNavHub } from '../../data/navigation';
import { ALL_BRANDS } from '../../data/brands';
import { getAllPublishedContent, getRelatedEntries, type AnyContentEntry } from '../../utils/content';

export async function getStaticPaths() {
  const hub = getNavHub('airport');
  const all = await getAllPublishedContent();

  const subtopicPaths = hub.subtopics.map((sub) => ({
    params: { slug: sub.slug },
    props: { kind: 'subtopic' as const, sub, entry: null as AnyContentEntry | null, all },
  }));

  const articlePaths = all
    .filter((e) => e.data.urlPath.startsWith('/airport/') && e.data.urlPath !== '/airport/')
    .map((entry) => {
      const slug = entry.data.urlPath.replace(/^\/airport\//, '').replace(/\/$/, '');
      return {
        params: { slug },
        props: { kind: 'article' as const, sub: null, entry, all },
      };
    });

  return [...subtopicPaths, ...articlePaths];
}

const { kind, sub, entry, all } = Astro.props;
const hub = getNavHub('airport');

const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const headings = rendered?.headings || [];
const related = entry
  ? getRelatedEntries(entry.data.urlPath, all, entry.data.relatedSlugs, entry.data.category, 3)
  : [];

// Contextual brands for subtopics
const matchedBrands = sub
  ? sub.slug === 'pianyi'
    ? ALL_BRANDS.filter((b) => b.startingMonthlyCny <= 10).slice(0, 6)
    : sub.slug === 'xingjiabi'
      ? ALL_BRANDS.filter((b) => b.dataCompleteness === 'full' && b.startingMonthlyCny <= 25).slice(0, 6)
      : sub.slug === 'wending'
        ? ALL_BRANDS.filter((b) => b.sinceYear && b.sinceYear <= 2023).slice(0, 6)
        : ALL_BRANDS.filter((b) => b.dataCompleteness === 'full').slice(0, 6)
  : [];

const relevantArticles = sub
  ? all.filter(
      (e) =>
        e.data.subtopic === sub.slug ||
        e.data.tags.some((t) => sub.title.includes(t) || t.includes(sub.title)) ||
        e.data.urlPath === sub.clusters[0]?.targetUrl ||
        e.data.urlPath === sub.clusters[1]?.targetUrl
    )
  : [];
---

{kind === 'subtopic' && sub ? (
  <TopicLayout
    title={`${sub.title} — ${hub.title}二级专题`}
    description={sub.description}
    urlPath={sub.href}
    badgeText={`${hub.title} · 二级专题`}
    breadcrumbs={[
      { name: '首页', href: '/' },
      { name: hub.title, href: hub.href },
      { name: sub.title, href: sub.href },
    ]}
    clusters={sub.clusters}
    latestEntries={relevantArticles.length > 0 ? relevantArticles : all.slice(0, 3)}
    coreQuestions={[
      {
        q: `浏览「${sub.title}」时最应核实哪些关键指标？`,
        a: '优先查看计费周期是否属于年付折算、线路标注来源（Vendor Data 还是实测截图）、以及是否支持你当前使用的 Clash / Shadowrocket 客户端。',
      },
      {
        q: '为什么本页不直接给出所谓「全网第一」的榜单？',
        a: '不同运营商（电信/联通/移动）与不同城市在晚高峰的路径差异显著，且商业合作与独立评估必须隔离。请结合独立评测与月付实测做判断。',
      },
    ]}
    nextLinks={[
      { title: `进入 ${ALL_BRANDS.length} 家品牌数据库筛选`, href: '/brands/', desc: '支持按价格区间、IEPL/IPLC 线路与不限时套餐条件筛选。' },
      { title: 'Clash Verge Rev 入门教程', href: '/clash/verge-complete-guide/', desc: '配置第三方订阅前先掌握官方客户端安全用法。' },
      { title: '机场跑路预警指南', href: '/resources/risk-alerts/', desc: '规避超低价两年/三年付跑路风险。' },
    ]}
  >
    <div class="space-y-8">
      <SubtopicGuideSection guideKey={`airport/${sub.slug}`} />
      {sub.slug !== 'mianfei-tizi' && matchedBrands.length > 0 && (
        <section>
          <div class="flex items-center justify-between gap-2 mb-4">
            <h2 class="text-xl font-bold text-text-title">数据库关联品牌档案（仅供参考，非推广排名）</h2>
            <a href="/brands/" class="text-xs font-semibold text-brand-primary hover:underline">全部 {ALL_BRANDS.length} 家品牌 →</a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {matchedBrands.map((b) => (
              <BrandCard brand={b} />
            ))}
          </div>
        </section>
      )}
    </div>
  </TopicLayout>
) : entry && Content ? (
  <TutorialLayout
    title={entry.data.title}
    description={entry.data.description}
    urlPath={entry.data.urlPath}
    category={entry.data.category}
    pubDate={entry.data.pubDate}
    updatedDate={entry.data.updatedDate}
    author={entry.data.author}
    tags={entry.data.tags}
    platform={entry.data.platform}
    appVersion={entry.data.appVersion}
    sources={entry.data.sources}
    faqs={entry.data.faqs}
    headings={headings}
    bodyText={entry.body}
    relatedEntries={related}
    breadcrumbs={[
      { name: '首页', href: '/' },
      { name: hub.title, href: hub.href },
      { name: entry.data.title, href: entry.data.urlPath },
    ]}
  >
    <Content />
  </TutorialLayout>
) : null}
