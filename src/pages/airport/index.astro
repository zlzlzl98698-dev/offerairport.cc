---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import TableOfContents from '../../components/common/TableOfContents.astro';
import AffiliateDisclosure from '../../components/commercial/AffiliateDisclosure.astro';
import RegistrationButton from '../../components/commercial/RegistrationButton.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getNavHub } from '../../data/navigation';
import { getBrandBySlug } from '../../data/brands';
import { getAllPublishedContent } from '../../utils/content';
import { SITE_CONFIG } from '../../data/site';
import { buildBreadcrumbSchema, buildCanonicalUrl } from '../../utils/seo';
import {
  AIRPORT_CORE_COMPARE_ROWS,
  AIRPORT_ONETIME_COMPARE_ROWS,
  AIRPORT_ANNUAL_BUDGET_ROWS,
  AIRPORT_BRAND_DIGESTS,
  AIRPORT_DECISION_BRANCHES,
  AIRPORT_HUB_FAQS,
  AIRPORT_INTERNAL_CLUSTER_LINKS,
} from '../../data/airport-hub-upgrade';

const hub = getNavHub('airport');
const urlPath = hub.href;
const title = `${hub.title}专题 — 独立选型、套餐对比与线路评估`;
const description =
  '围绕 32 家机场品牌审计与 2026-08-11 实测截图档案的独立选型总指南：拆分真实月付价与年付折算月均价、对比 IEPL/IPLC 专线与客户端兼容性、盘点一次性不限时流量包与 5.6 元同质化风险，并提供可核查的品牌档案与决策分支。';

const verifiedDate = '2026-11-20';

const all = await getAllPublishedContent();
const relevant = all.filter(
  (e) =>
    e.data.category.includes('机场') ||
    e.data.urlPath.startsWith('/reviews/') ||
    e.data.urlPath.startsWith('/comparisons/')
);
const featured = relevant.filter((e) => e.data.featured).slice(0, 4);

const showcaseSlugs = ['guangsuyun', 'weitu', 'yifan', 'xingdaomeng', 'ermao', 'feimao'];
const showcaseBrands = showcaseSlugs
  .map((s) => getBrandBySlug(s))
  .filter((b): b is NonNullable<typeof b> => Boolean(b));

const breadcrumbs = [
  { name: '首页', href: '/' },
  { name: hub.title, href: urlPath },
];

const headings = [
  { depth: 2, slug: 'core-candidates-table', text: '一、主流候选机场核心对比总表（月付实价与年付折算拆分）' },
  { depth: 3, slug: 'onetime-plans-compare', text: '分项对比表 A：一次性不过期不限时流量包横向对比' },
  { depth: 3, slug: 'budget-annual-audit', text: '分项对比表 B：百元以内年付小包及 5.6 元同质化集群审计' },
  { depth: 2, slug: 'brand-digests', text: '二、重点候选服务集中解析与适用边界（逐家对照）' },
  { depth: 2, slug: 'pricing-and-metrics', text: '三、决定体验与实际支出的四大技术与计费原理' },
  { depth: 3, slug: 'amortized-vs-monthly', text: '1. 年付折算均价陷阱与节点流量倍率规则' },
  { depth: 3, slug: 'speedtest-reading-rules', text: '2. 如何科学读懂 2026-08-11 测速截图档案（勿迷信单张高跑分）' },
  { depth: 3, slug: 'line-and-client-boundary', text: '3. IEPL / IPLC 专线与专属客户端 vs 第三方通用订阅取舍' },
  { depth: 2, slug: 'ai-failover-and-risk', text: '四、AI 办公解锁、独享原生 IP 边界与双活容灾实战' },
  { depth: 2, slug: 'decision-paths', text: '五、按预算、用途与风险承受能力的五条决策分支' },
  { depth: 2, slug: 'brand-cards', text: '六、核心候选查看套餐卡片与 7 个二级子栏目导航' },
  { depth: 2, slug: 'data-sources-and-gaps', text: '七、资料来源、待核实 / 历史存档清单与透明度边界' },
  { depth: 2, slug: 'faq', text: '八、机场推荐与选型高频边界问题 FAQ（9 问）' },
  { depth: 2, slug: 'related-clusters', text: '九、站内对比集群、深度评测与风控阅读导航' },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: buildCanonicalUrl(urlPath),
    inLanguage: 'zh-CN',
    dateModified: verifiedDate,
    author: {
      '@type': 'Organization',
      name: SITE_CONFIG.author,
    },
    isPartOf: {
      '@type': 'WebSite',
      name: SITE_CONFIG.name,
      url: SITE_CONFIG.domain,
    },
    hasPart: hub.subtopics.map((s) => ({
      '@type': 'CollectionPage',
      name: s.title,
      url: buildCanonicalUrl(s.href),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: AIRPORT_HUB_FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={urlPath}
  ogType="article"
  author={SITE_CONFIG.author}
  publishDate="2026-10-15T00:00:00Z"
  modifiedDate={`${verifiedDate}T18:55:00+08:00`}
  tags={['机场推荐', '性价比机场', '稳定机场', '便宜机场', 'IEPL专线', '不限时流量包', '机场排行']}
  structuredData={schemas}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Main Monograph Article Column -->
      <article class="lg:col-span-8 min-w-0 space-y-10" data-pagefind-body>
        <!-- Header & Answer-First Executive Summary -->
        <header class="rounded-3xl bg-bg-surface border border-border-subtle p-6 sm:p-8 space-y-5">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="px-2.5 py-1 rounded-full bg-brand-soft text-brand-primary border border-blue-200 font-semibold">
              一级导航专题 ① · 商业评测与独立选型区
            </span>
            <span class="px-2.5 py-1 rounded-full bg-white text-text-title border border-border-subtle font-mono">
              最近核实：2026-10-19 / 页面更新：{verifiedDate}
            </span>
            <span class="px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200 font-medium">
              含合作推广返佣披露 · 先测后付原则
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-text-title tracking-tight leading-tight">
            {title}
          </h1>

          <p class="text-sm sm:text-base text-text-body leading-relaxed">
            挑选跨境代理服务（俗称“机场”）最容易踩的两类坑，一是把商家宣传的“¥5.6/月”或“¥8/月”当成真的可以按单月买，点进去才发现是一次性年付小包折算均价；二是仅凭单张白天测速高跑分就盲目囤两三年会员，忽略了晚高峰跨网丢包、专属客户端锁死以及运营周期短的风险。本页面汇总本站 32 家品牌审计数据库与 2026-08-11 实测截图档案，先给出明确候选结论，再拆分计费陷阱与场景决策路线。
          </p>

          <AffiliateDisclosure compact extraNote={SITE_CONFIG.vendorDataDisclaimer} />

          <!-- Answer-First Direct Candidates & Conclusion Box -->
          <div class="rounded-2xl bg-white border border-blue-200 p-5 space-y-3 shadow-xs">
            <div class="flex items-center gap-2 text-sm font-bold text-brand-primary">
              <span>直接选购结论（先看核心候选，再查细表）</span>
            </div>
            <ul class="space-y-2 text-sm text-text-body leading-relaxed list-disc pl-5">
              <li>
                <strong>20 元左右主流月付均衡主力（最稳起步）：</strong>重视 2020 年老牌运营与 12 国节点选 <strong>光速云</strong>（真实月付 ¥25/168GB，支持自研+Clash）；看重 ¥20 内高性价比 1 倍率 Trojan 选 <strong>唯兔云</strong>（¥19.9/150GB）；需要 Hysteria 2 + VLESS-Reality 三协议切换应对复杂宽带选 <strong>一翻云</strong>（¥20/150GB）；看重 2020 老牌且需韩/东南亚节点选 <strong>星岛梦</strong>（¥25/150GB）。
              </li>
              <li>
                <strong>极低频备用 / 一次性不过期流量包（百元灾备）：</strong>只推荐选择<strong>支持 Clash 第三方订阅</strong>的百元档，便于挂载双活备用：<strong>光速云·致敬斯诺克 147 永久版</strong>（¥147/247GB，约 ¥0.595/GB）、<strong>唯兔云</strong>（¥100/100GB 或 ¥160/200GB）、<strong>二猫云</strong>（¥99/100GB）、<strong>一翻云</strong>（¥100/100GB）、<strong>星岛梦</strong>（¥100/100GB）。
              </li>
              <li>
                <strong>完全不想折腾 Clash 的新手专属客户端派：</strong>可对比 <strong>飞猫云</strong>（¥25/150GB 或学生版 ¥84/年）或 <strong>Firefly 萤火虫</strong>（IPLC 原生 IP，¥25/150GB），但必须提前清楚此类“仅专属客户端”服务<strong>无法导入 OpenWrt 软路由与 Clash Verge Rev</strong>。
              </li>
              <li>
                <strong>新人避坑铁律：</strong>第一家服务<strong>坚决不直接买年付</strong>，先买 1 个月真实月付在晚间 20:30–23:00 实测本地电信/联通/移动宽带表现；高度同质化的 <strong>¥5.6/月集群（大佬云/闪电鼠/云界线/榴莲云/环球梯）</strong> 及 <strong>待核实/历史存档品牌（宇宙云/灵动云/浪网/EdgeNova/快狸）</strong> 不宜作为唯一主力依赖。
              </li>
            </ul>
            <div class="pt-1 flex flex-wrap gap-2.5 text-xs">
              <a
                href="#core-candidates-table"
                class="px-3.5 py-2 rounded-xl bg-brand-primary text-white font-semibold hover:bg-brand-primary-hover transition-colors"
              >
                对比核心候选月付/年付表
              </a>
              <a
                href="#brand-cards"
                class="px-3.5 py-2 rounded-xl bg-bg-surface text-text-title border border-border-subtle font-semibold hover:border-brand-primary transition-colors"
              >
                直达品牌套餐与官网卡片
              </a>
              <a
                href="/brands/"
                class="px-3.5 py-2 rounded-xl bg-bg-surface text-text-title border border-border-subtle font-semibold hover:border-brand-primary transition-colors"
              >
                打开 32 家交互筛选库
              </a>
            </div>
          </div>

          <!-- Mobile Collapsible TOC -->
          <div class="lg:hidden">
            <details class="rounded-2xl border border-border-subtle bg-white p-4">
              <summary class="text-sm font-bold text-text-title cursor-pointer flex items-center justify-between">
                <span>本页完整章节目录（共 9 章）</span>
                <span class="text-xs font-normal text-brand-primary">点击展开</span>
              </summary>
              <nav class="mt-3 space-y-1.5 text-xs border-t border-border-subtle pt-3">
                {headings.map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class:list={[
                      'block py-1 hover:text-brand-primary transition-colors',
                      h.depth === 2 ? 'font-semibold text-text-title' : 'pl-3 text-text-muted',
                    ]}
                  >
                    {h.text}
                  </a>
                ))}
              </nav>
            </details>
          </div>
        </header>

        <!-- Section 1: Core Comparison Table + 2 Sub-Tables -->
        <section id="core-candidates-table" class="scroll-mt-24 space-y-6">
          <h2 class="text-xl sm:text-2xl font-bold text-text-title pb-2.5 border-b border-border-subtle">
            一、主流候选机场核心对比总表（月付实价与年付折算拆分）
          </h2>
          <p class="text-sm sm:text-base text-text-body leading-relaxed">
            为避免价格宣传误导，下表统一采用人民币（¥）标价，强制将<strong>可单独按月购买的真实月付起步价</strong>与<strong>需一次性预付全年的年付折算月均价</strong>分成两列呈现，同时原样写明设备限制、倍率标注、客户端兼容方式、AI 解锁态度及实测档案来源。缺失字段明确标示为待核实，不做跨品牌猜测填充。
          </p>

          <div class="rounded-2xl border border-border-subtle bg-white overflow-hidden">
            <div class="px-4 py-3 bg-bg-surface border-b border-border-subtle flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm font-bold text-text-title">表 1：主流候选机场月付实价、年付折算与接入矩阵（10 家）</span>
              <span class="text-xs text-text-muted sm:hidden">左右滑动查看完整列 →</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[620px] lg:min-w-0 text-left border-collapse text-xs sm:text-[13px]">
                <thead>
                  <tr class="bg-bg-surface/70 border-b border-border-subtle text-text-title">
                    <th class="p-3 sm:p-3.5 font-bold w-[17%]">品牌与起步</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[28%]">月付实价 vs 年付折算</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[26%]">线路、协议与倍率设备</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[29%]">AI / 实测与使用限制</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle text-text-body">
                  {AIRPORT_CORE_COMPARE_ROWS.map((row) => (
                    <tr class="hover:bg-slate-50/70 align-top">
                      <td class="p-3 sm:p-3.5 leading-relaxed">
                        <a href={`/brands/${row.slug}/`} class="font-bold text-brand-primary hover:underline text-sm">
                          {row.name}
                        </a>
                        <span class="block text-[11px] text-text-muted mt-0.5">起于 {row.sinceYear}</span>
                        <span class="inline-block mt-1.5 px-2 py-0.5 rounded-md bg-bg-surface border border-border-subtle text-[11px] text-text-title">
                          {row.clientMode.includes('仅官方专属') ? '仅专属端' : row.clientMode.includes('自研') ? '自研+第三方' : '第三方订阅'}
                        </span>
                      </td>
                      <td class="p-3 sm:p-3.5 leading-relaxed space-y-1.5">
                        <div class="font-medium text-text-title">
                          <span class="text-brand-primary font-semibold">月付：</span>{row.realMonthlyStart}
                        </div>
                        <div class="text-xs text-text-body">
                          <span class="text-text-muted font-semibold">年付：</span>{row.annualAmortized}
                        </div>
                      </td>
                      <td class="p-3 sm:p-3.5 leading-relaxed space-y-1.5">
                        <div>{row.lineAndProtocols}</div>
                        <div class="text-xs text-text-muted">{row.multiplierAndDevices}</div>
                        <div class="text-xs text-text-muted">接入：{row.clientMode}</div>
                      </td>
                      <td class="p-3 sm:p-3.5 leading-relaxed space-y-1.5">
                        <div>{row.aiAndVerification}</div>
                        <div class="text-xs text-text-muted">{row.limitsAndSource}</div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <h3 id="onetime-plans-compare" class="text-lg sm:text-xl font-bold text-text-title pt-2">
            分项对比表 A：一次性不过期不限时流量包横向对比
          </h3>
          <p class="text-sm sm:text-base text-text-body leading-relaxed">
            对于每月消耗低于 15GB 的轻度资料查询用户，或需要配置第二家“永不清零热备线路”来防范主力机场维护断流的用户，百元级一次性不限时包能大幅降低年度固定支出。需注意：作为灾备放进 Clash 自动切换组（Fallback）的前提是该品牌<strong>必须提供第三方通用订阅</strong>。
          </p>

          <div class="rounded-2xl border border-border-subtle bg-white overflow-hidden">
            <div class="px-4 py-3 bg-bg-surface border-b border-border-subtle flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm font-bold text-text-title">表 2：一次性不限时流量包成本与 Clash 兼容性对比</span>
              <span class="text-xs text-text-muted sm:hidden">左右滑动查看完整列 →</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[600px] lg:min-w-0 text-left border-collapse text-xs sm:text-[13px]">
                <thead>
                  <tr class="bg-bg-surface/70 border-b border-border-subtle text-text-title">
                    <th class="p-3 sm:p-3.5 font-bold w-[24%]">品牌与套餐名</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[22%]">实付 / 买断流量</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[24%]">客户端兼容性</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[30%]">核心选型提示</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle text-text-body">
                  {AIRPORT_ONETIME_COMPARE_ROWS.map((row) => (
                    <tr class="hover:bg-slate-50/70 align-top">
                      <td class="p-3 sm:p-3.5 leading-relaxed">
                        <a href={`/brands/${row.slug}/`} class="font-bold text-brand-primary hover:underline text-sm">
                          {row.brand}
                        </a>
                        <span class="block text-xs text-text-muted mt-0.5">{row.planName}</span>
                      </td>
                      <td class="p-3 sm:p-3.5 leading-relaxed space-y-1">
                        <div class="font-semibold text-text-title">{row.oneTimePrice} · {row.totalTraffic}</div>
                        <span class="inline-block px-2 py-0.5 rounded-md bg-brand-soft text-brand-primary font-semibold text-[11px]">
                          折合 {row.unitCost}
                        </span>
                      </td>
                      <td class="p-3 sm:p-3.5 leading-relaxed">{row.clientCompat}</td>
                      <td class="p-3 sm:p-3.5 leading-relaxed">{row.note}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <h3 id="budget-annual-audit" class="text-lg sm:text-xl font-bold text-text-title pt-2">
            分项对比表 B：百元以内年付小包及 5.6 元同质化集群审计
          </h3>
          <p class="text-sm sm:text-base text-text-body leading-relaxed">
            搜索“便宜机场”时最常见的就是月均 5.6 元至 8 元的年付轻量包。下表把经过实测存档验证的年付入门档与存在高度模板雷同的 5.6 元集群并排对照，避免你因为仅看一个“5.6 元/月”标题而承担过高的不确定风险。详见
            <a href="/comparisons/cheap-annual-airports-audit/" class="text-brand-primary font-semibold hover:underline">5.6–8 元年付入门档完整审计报告</a>。
          </p>

          <div class="rounded-2xl border border-border-subtle bg-white overflow-hidden">
            <div class="px-4 py-3 bg-bg-surface border-b border-border-subtle flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm font-bold text-text-title">表 3：年付入门档与 5.6 元同质化集群横排审计</span>
              <span class="text-xs text-text-muted sm:hidden">左右滑动查看完整列 →</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[600px] lg:min-w-0 text-left border-collapse text-xs sm:text-[13px]">
                <thead>
                  <tr class="bg-bg-surface/70 border-b border-border-subtle text-text-title">
                    <th class="p-3 sm:p-3.5 font-bold w-[24%]">品牌 / 套餐档位</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[23%]">年付实付 / 折算 / 流量</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[22%]">线路协议与接入</th>
                    <th class="p-3 sm:p-3.5 font-bold w-[31%]">审计结论与主要限制</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle text-text-body">
                  {AIRPORT_ANNUAL_BUDGET_ROWS.map((row) => (
                    <tr class="hover:bg-slate-50/70 align-top">
                      <td class="p-3 sm:p-3.5 font-bold text-text-title leading-relaxed">
                        {row.slug ? (
                          <a href={`/brands/${row.slug}/`} class="text-brand-primary hover:underline">
                            {row.brand}
                          </a>
                        ) : (
                          row.brand
                        )}
                      </td>
                      <td class="p-3 sm:p-3.5 leading-relaxed space-y-1">
                        <div class="font-semibold text-text-title">{row.annualPrice}（折 {row.amortizedMonthly}）</div>
