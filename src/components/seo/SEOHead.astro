---
import { SITE_CONFIG, SITE_VERIFICATION } from '../../data/site';
import { buildCanonicalUrl } from '../../utils/seo';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  disableCanonical?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  author?: string;
  publishDate?: string;
  modifiedDate?: string;
  tags?: string[];
  structuredData?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  disableCanonical = false,
  ogImage = '/images/og-cover.png',
  ogType = 'website',
  author = SITE_CONFIG.author,
  publishDate,
  modifiedDate,
  tags = [],
  structuredData,
  noindex = false,
} = Astro.props;

const resolvedCanonical = canonicalUrl
  ? buildCanonicalUrl(canonicalUrl)
  : buildCanonicalUrl(Astro.url.pathname);

const resolvedOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, SITE_CONFIG.domain).toString();

const fullTitle = title.includes(SITE_CONFIG.name)
  ? title
  : `${title} | ${SITE_CONFIG.name}`;

const schemas = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta http-equiv="content-language" content="zh-CN" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? (
  <meta name="robots" content="noindex, follow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
)}

{!disableCanonical && <link rel="canonical" href={resolvedCanonical} />}

<meta property="og:locale" content="zh_CN" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_CONFIG.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:image" content={resolvedOgImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />

{author && <meta name="author" content={author} />}
{publishDate && <meta property="article:published_time" content={publishDate} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<link rel="icon" type="image/webp" href="/images/site-avatar.webp" />
<link rel="sitemap" href="/sitemap-index.xml" />

{SITE_VERIFICATION.google && <meta name="google-site-verification" content={SITE_VERIFICATION.google} />}
{SITE_VERIFICATION.bing && <meta name="msvalidate.01" content={SITE_VERIFICATION.bing} />}
{SITE_VERIFICATION.shenma && <meta name="shenma-site-verification" content={SITE_VERIFICATION.shenma} />}
{SITE_VERIFICATION.baidu && <meta name="baidu-site-verification" content={SITE_VERIFICATION.baidu} />}

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
