---
import type { BrandRecord, UnlockStatus } from '../../data/brands/types';

interface Props {
  brand: BrandRecord;
}

const { brand } = Astro.props;

const statusMeta: Record<UnlockStatus, { label: string; dot: string; badge: string }> = {
  'measured-yes': {
    label: 'Measured Supported',
    dot: 'bg-emerald-400',
    badge: 'text-emerald-300 bg-emerald-500/15 border-emerald-500/30',
  },
  'measured-no': {
    label: 'Measured Failed',
    dot: 'bg-rose-400',
    badge: 'text-rose-300 bg-rose-500/15 border-rose-500/30',
  },
  'partial-nodes': {
    label: 'Partial / Node-Dependent',
    dot: 'bg-amber-400',
    badge: 'text-amber-300 bg-amber-500/15 border-amber-500/30',
  },
  'vendor-claimed': {
    label: 'Vendor Claimed',
    dot: 'bg-sky-400',
    badge: 'text-sky-300 bg-sky-500/15 border-sky-500/30',
  },
  'not-tested': {
    label: 'Not Tested',
    dot: 'bg-slate-400',
    badge: 'text-slate-300 bg-slate-500/20 border-slate-600/40',
  },
};
---

<section
  class="rounded-2xl bg-[#0B1220] text-slate-100 border border-slate-800 p-5 sm:p-6 my-6 shadow-lg"
  aria-label={`${brand.name} AI 与流媒体可用性矩阵`}
>
  <div class="flex flex-wrap items-start justify-between gap-3 pb-4 border-b border-slate-800/90">
    <div>
      <div class="flex items-center gap-2 text-xs font-mono text-slate-400 uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full" style={`background-color: ${brand.accentColor}`}></span>
        <span>Service Availability Matrix</span>
      </div>
      <h3 class="text-lg font-bold text-white mt-1">
        {brand.name} AI 工具与流媒体解锁状态矩阵
      </h3>
    </div>
    <span class="text-xs font-mono text-slate-400">核实日期: {brand.verifiedAt}</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-4">
    {brand.streamingMatrix.map((item) => {
      const meta = statusMeta[item.status];
      return (
        <div class="bg-[#111A2E] rounded-xl p-3.5 border border-slate-800/90 flex flex-col justify-between gap-2">
          <div class="flex items-center justify-between gap-2">
            <span class="font-semibold text-sm text-white">{item.service}</span>
            <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-mono border ${meta.badge}`}>
              <span class={`w-1.5 h-1.5 rounded-full ${meta.dot}`}></span>
              {meta.label}
            </span>
          </div>
          {item.note && (
            <p class="text-xs text-slate-400 leading-snug">{item.note}</p>
          )}
        </div>
      );
    })}
  </div>

  <p class="text-[11px] text-slate-400 mt-4 leading-relaxed">
    状态说明：<strong class="text-slate-200">Vendor Claimed</strong> 代表来自服务商公开资料声明，非本站独立长期测试；<strong class="text-slate-200">Partial / Node-Dependent</strong> 表示需要手动切换至特定地区落地节点；<strong class="text-slate-200">Not Tested</strong> 表示目前缺乏可核实测试结果。
  </p>
</section>
