---
import type { BreadcrumbItem } from '../../utils/seo';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="面包屑导航" class="mb-5 text-sm text-text-muted" data-pagefind-ignore>
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((item, idx) => {
      const isLast = idx === items.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {idx > 0 && (
            <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
            </svg>
          )}
          {isLast ? (
            <span class="font-medium text-text-title truncate max-w-[240px] sm:max-w-none" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.href} class="hover:text-brand-primary transition-colors">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
