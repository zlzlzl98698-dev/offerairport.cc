---
import { getBrandBySlug } from '../../data/brands';
import RegistrationButton from './RegistrationButton.astro';

interface Props {
  brandSlug: string;
  highlightNote?: string;
}

const { brandSlug, highlightNote } = Astro.props;
const brand = getBrandBySlug(brandSlug);
---

{brand && (
  <div class="rounded-2xl border border-border-subtle bg-white p-5 sm:p-6 shadow-sm flex flex-col justify-between gap-4">
    <div class="space-y-3">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2.5">
          {brand.logo && (
            <img src={brand.logo} alt={`${brand.name} 图标`} width="36" height="36" loading="lazy" class="w-9 h-9 rounded-lg object-contain bg-bg-surface p-0.5 border border-border-subtle" />
          )}
          <div>
            <h3 class="text-base font-bold text-text-title">
              <a href={`/brands/${brand.slug}/`} class="hover:text-brand-primary">{brand.name}</a>
            </h3>
            <p class="text-xs text-text-muted">{brand.positioning}</p>
          </div>
        </div>
        {brand.promoCode && (
          <span class="px-2.5 py-1 rounded-lg bg-brand-soft text-brand-primary font-mono text-xs font-semibold">
            码: {brand.promoCode}
          </span>
        )}
      </div>

      <p class="text-sm text-text-body">{highlightNote || brand.summary}</p>
      <div class="text-xs font-medium text-text-title bg-bg-surface px-3 py-2 rounded-lg border border-border-subtle">
        起步价：{brand.startingMonthlyDisplay}
      </div>
    </div>

    <div class="pt-2 border-t border-border-subtle">
      <RegistrationButton brandSlug={brand.slug} label={`前往 ${brand.name}`} />
    </div>
  </div>
)}
