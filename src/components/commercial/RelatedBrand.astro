---
import { getBrandBySlug } from '../../data/brands';
import RegistrationButton from './RegistrationButton.astro';

interface Props {
  brandSlug: string;
  showRegister?: boolean;
}

const { brandSlug, showRegister = true } = Astro.props;
const brand = getBrandBySlug(brandSlug);
---

{brand && (
  <div class="rounded-2xl border border-border-subtle bg-bg-surface p-5 space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <span class="text-xs font-medium text-text-muted">关联品牌档案</span>
        <h3 class="text-lg font-bold text-text-title">
          <a href={`/brands/${brand.slug}/`} class="hover:text-brand-primary">{brand.name}</a>
        </h3>
      </div>
      <a
        href={`/brands/${brand.slug}/`}
        class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-white border border-border-subtle text-text-title hover:border-brand-primary"
      >
        查看完整套餐与风险说明
      </a>
    </div>

    <p class="text-sm text-text-body leading-relaxed">{brand.summary}</p>

    <div class="flex flex-wrap gap-2 text-xs">
      <span class="px-2.5 py-1 rounded-md bg-white border border-border-subtle">{brand.startingMonthlyDisplay}</span>
      <span class="px-2.5 py-1 rounded-md bg-white border border-border-subtle">{brand.lineType}</span>
      <span class="px-2.5 py-1 rounded-md bg-white border border-border-subtle">{brand.clientMode}</span>
    </div>

    {showRegister && (
      <div class="pt-2 border-t border-border-subtle">
        <RegistrationButton brandSlug={brand.slug} variant="secondary" />
      </div>
    )}
  </div>
)}
